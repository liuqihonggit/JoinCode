<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>JoinCode.Guard</RootNamespace>
    <AssemblyName>JoinCode.Guard</AssemblyName>
    <PackageId>JoinCode.Guard</PackageId>
    <Description>JoinCode Guard 子系统 — 权限管理、安全护栏、Hook 系统、配置加载、OAuth 认证</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)01_shared/shared_abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)01_shared/shared_infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)00_generators/enum_metadata.generator/src/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)00_generators/mcp_tool_dispatch.generator/src/McpToolDispatch.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)00_generators/danger_command.generator/src/DangerCommand.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsDependencyInjectionVersion)" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Dream.Tests" />
    <InternalsVisibleTo Include="JoinCode.Guard.Tests" />
    <InternalsVisibleTo Include="JoinCode.Guard.Config.Tests" />
    <InternalsVisibleTo Include="JoinCode.Guard.Security.Tests" />
    <InternalsVisibleTo Include="JoinCode.Guard.Hooks.Tests" />
  </ItemGroup>



  </Project>

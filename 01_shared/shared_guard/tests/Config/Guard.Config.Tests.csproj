<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Guard.Config.Tests</RootNamespace>
    <AssemblyName>JoinCode.Guard.Config.Tests</AssemblyName>
    <Description>JoinCode Guard Config 子系统单元测试（Configuration + Policy + Plugins + 枚举扩展）</Description>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\.runsettings</RunSettingsFilePath>
    <NoWarn>$(NoWarn);JCC3007;JCC3010;JCC3011;JCC3012;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)01_shared/shared_guard/src/Guard.csproj" />
    <ProjectReference Include="$(RepoRoot)01_shared/shared_infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)01_shared/shared_plugins/plugins.infrastructure/Plugins.Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)tests/unit/testing.common/Testing.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(MicrosoftExtensionsTimeProviderTestingVersion)" />
  </ItemGroup>

</Project>

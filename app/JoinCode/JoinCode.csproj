<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>JoinCode</RootNamespace>
    <AssemblyName>jcc</AssemblyName>
    <Description>JoinCode 命令行工具</Description>
    <NoWarn>$(NoWarn);JCC9001;CS8604;CS1573;CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)composition\Composition\src\Composition.csproj" />
    <ProjectReference Include="$(RepoRoot)composition\Clock\src\Clock.csproj" />
    <ProjectReference Include="$(RepoRoot)services\Dream\src\Dream.csproj" />
    <ProjectReference Include="$(RepoRoot)core\search\Browser\src\Browser.csproj" />
    <ProjectReference Include="$(RepoRoot)composition\Pipelines\src\Pipelines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)00_generators/McpToolDispatch.Generator\src\McpToolDispatch.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)00_generators/EnumMetadata.Generator\src\EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)00_generators/CliOption.Generator\src\CliOption.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)00_generators/AppModule.Generator\src\AppModule.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Dream.Tests" />
    <InternalsVisibleTo Include="JoinCode.Clock.Tests" />
    <InternalsVisibleTo Include="JoinCode.Composition.Tests" />
    <InternalsVisibleTo Include="JoinCode.Host.Tests" />
    <InternalsVisibleTo Include="JoinCode.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <!-- === 原生 DLL 嵌入资源（Release/AOT 模式） === -->
  <!-- NativeAOT 无法静态链接 C/C++ 原生库，嵌入为 EmbeddedResource，运行时由 NativeDllBootstrapper 释放 -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <EmbeddedResource Include="$(NuGetPackageRoot)\skiasharp.nativeassets.win32\4.151.1\runtimes\win-x64\native\libSkiaSharp.dll" LogicalName="JoinCode.NativeDlls.libSkiaSharp.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)\docnet.core\$(DocnetCoreVersion)\runtimes\win-x64\native\pdfium.dll" LogicalName="JoinCode.NativeDlls.pdfium.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)\treesitter.dotnet\1.3.0\runtimes\win-x64\native\*.dll" LogicalName="JoinCode.NativeDlls.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- publish 后清理原生 DLL — 已嵌入资源，无需外部 DLL -->
  <Target Name="RemoveNativeDllsFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <NativeDllInPublish Include="$(PublishDir)\libSkiaSharp.dll" />
      <NativeDllInPublish Include="$(PublishDir)\libSkiaSharp.pdb" />
      <NativeDllInPublish Include="$(PublishDir)\pdfium.dll" />
      <NativeDllInPublish Include="$(PublishDir)\tree-sitter*.dll" />
    </ItemGroup>
    <Delete Files="@(NativeDllInPublish)" />
    <Message Importance="High" Text="Removed @(NativeDllInPublish->Count()) native DLLs from publish dir (embedded in exe)" />
  </Target>

  </Project>

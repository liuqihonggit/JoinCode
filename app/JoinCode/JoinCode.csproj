<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>JoinCode</RootNamespace>
    <AssemblyName>jcc</AssemblyName>
    <Description>JoinCode 命令行工具</Description>
    <NoWarn>$(NoWarn);JCC9001;CS8604;CS1573;CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules\Brain\src\Brain.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Hands\src\Hands.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Eyes\src\Eyes.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Vault\src\Vault.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Composition\src\Composition.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Guard\src\Guard.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Clock\src\Clock.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Bridge\src\Bridge.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Dream\src\Dream.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Browser\src\Browser.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Transport.Contracts\Transport.Contracts.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Transport.Impl\Transport.Impl.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Reasoning\src\Reasoning.csproj" />
    <ProjectReference Include="$(RepoRoot)modules\Agents\src\Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)generators\McpToolHandlers.Generator\src\McpToolHandlers.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)generators\EnumMetadata.Generator\src\EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)generators\CliOption.Generator\src\CliOption.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)generators\AppModule.Generator\src\AppModule.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Dream.Tests" />
    <InternalsVisibleTo Include="JoinCode.Clock.Tests" />
    <InternalsVisibleTo Include="JoinCode.Composition.Tests" />
    <InternalsVisibleTo Include="JoinCode.Host.Tests" />
    <InternalsVisibleTo Include="JoinCode.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="System.CommandLine" Version="$(SystemCommandLineVersion)" />
  </ItemGroup>



  </Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JoinCode.Gui.Views.ConfirmDialogWindow"
        Title="确认"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="16" Spacing="14">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="OkButton" Content="确定" MinWidth="80" Click="OnOkClick" />
      <Button x:Name="CancelButton" Content="取消" MinWidth="80" Click="OnCancelClick" />
    </StackPanel>
  </StackPanel>
</Window>

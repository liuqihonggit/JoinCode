<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
        xmlns:vm="using:JoinCode.Gui.ViewModels"
        xmlns:md="using:JoinCode.Gui.Markdown"
        x:Class="JoinCode.Gui.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Width="980" Height="680"
        Title="JoinCode Ava">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource GuiButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GuiButtonBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource GuiButtonForeground}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource GuiButtonHover}" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{DynamicResource GuiButtonPressed}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </Window.Styles>

  <!-- 根 Grid：侧边栏(*) : 主区(4*) 比例对齐 -->
  <Grid ColumnDefinitions="*,4*">

    <!-- ===== Column 0：侧边栏 ===== -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource GuiSidebarBackground}" ClipToBounds="True">
      <!-- 头部 -->
      <StackPanel Grid.Row="0" Spacing="10" Margin="12,14,12,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="◆" FontSize="18" Foreground="{DynamicResource GuiAccentText}" />
          <TextBlock Text="JoinCode Ava" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GuiSidebarTitle}" />
        </StackPanel>
        <Button Content="＋ 新建对话" Command="{Binding NewConversationCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,5" />
      </StackPanel>
      <!-- 会话列表 -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6">
        <StackPanel DataContext="{Binding}">
          <TextBlock Text="会话列表" Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="4,0,0,6" />
          <ItemsControl ItemsSource="{Binding Sessions}" Margin="6,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionItem">
                <Border Padding="10,9" CornerRadius="5" Background="{Binding IsSelected, Converter={StaticResource BoolToSessHighlight}}"
                        DoubleTapped="OnSessionDoubleTapped"
                        Tapped="OnSessionSingleTapped"
                        Cursor="Hand">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="💬" FontSize="12" />
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource GuiPrimaryText}" FontSize="12" VerticalAlignment="Center"
                                 IsVisible="{Binding !IsRenaming}" />
                      <TextBox Text="{Binding RenameDraft}" FontSize="12" Padding="2,0"
                               IsVisible="{Binding IsRenaming}"
                               KeyDown="OnRenameKeyDown" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" FontSize="9" Padding="2,0" Background="Transparent"
                            BorderThickness="0" Foreground="{DynamicResource GuiMutedText}"
                            Tag="{Binding}" Click="OnSessionRemoveClick" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <!-- 底部状态 -->
      <Border Grid.Row="2" Padding="14,10" Background="{DynamicResource GuiStatusBarBackground}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="●" Foreground="{DynamicResource GuiAccentText}" />
          <TextBlock Text="本地引擎待接入" FontSize="11" Foreground="{DynamicResource GuiMutedText}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===== Column 1：主区 ===== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">

      <!-- Row 0：顶部工具栏 -->
      <Border Grid.Row="0" Padding="10,8" Background="{DynamicResource GuiTopBarBackground}" ClipToBounds="True">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,*,*,Auto" ColumnSpacing="10">
          <ToggleButton Content="🌙" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="切换深浅主题" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="StatusDot" Text="●" FontSize="12" Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Content="↻ 重新生成" Command="{Binding RegenerateLastReplyCommand}"
                  IsEnabled="{Binding CanRegenerate}" FontSize="11" ToolTip.Tip="撤回上一轮并重新生成" />
          <Button Grid.Column="3" Content="🗑 清空" Command="{Binding ClearHistoryCommand}"
                  IsEnabled="{Binding HasMessages}" />
          <Button Grid.Column="4" Content="⊘ 全部重置" Command="{Binding ClearAllSessionsCommand}"
                  FontSize="11" />
          <ComboBox Grid.Column="5" ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding SelectedConnection}"
                    HorizontalAlignment="Stretch" ToolTip.Tip="当前连接的引擎（Mock 为演示/本地验证环境）">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConnectionOptionItem">
                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox Grid.Column="6" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModelOption}"
                    PlaceholderText="选择模型" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelOptionItem">
                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="7" Content="⛭" ToolTip.Tip="设置面板" Command="{Binding ToggleSettingsPanelCommand}" />
        </Grid>
      </Border>

      <!-- Row 1：消息区（消息内容(*) : 设置面板(Auto)） -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ClipToBounds="True">

        <!-- Column 0：消息内容（搜索栏 + 消息列表） -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
          <!-- 搜索栏 -->
          <Border Grid.Row="0" Padding="10,6" Background="{DynamicResource GuiSearchBarBackground}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
              <TextBox Text="{Binding SearchText}" Watermark="搜索消息…" FontSize="12" Padding="6,2"
                       VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text=" 🔍" VerticalAlignment="Center"
                         IsVisible="{Binding IsSearching}" />
              <TextBlock Grid.Column="2" Text="{Binding MessageCount, StringFormat='{} 消息 {0}'}"
                         Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" Margin="14,0" />
              <TextBlock Grid.Column="3" Text="{Binding EstimatedTokens, StringFormat='{} 约 {0} tokens'}"
                         Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding TotalChars, StringFormat='{} {0} 字符'}"
                         Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" Margin="14,0" />
              <Button Grid.Column="5" Content="⧉ 导出" Command="{Binding CopySessionExportCommand}"
                      FontSize="11" Padding="8,3" IsEnabled="{Binding HasMessages}"
                      ToolTip.Tip="复制会话为文本" />
            </Grid>
          </Border>
          <!-- 消息列表区 -->
          <Panel Grid.Row="1" ClipToBounds="True">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        IsVisible="{Binding !HasMessages}">
              <TextBlock Text="👋" FontSize="40" HorizontalAlignment="Center" />
              <TextBlock Text="开始与 JoinCode 对话" FontSize="18" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Foreground="{DynamicResource GuiPrimaryText}" />
              <TextBlock Text="在下方输入消息，Enter 发送" FontSize="13"
                         HorizontalAlignment="Center" Foreground="{DynamicResource GuiMutedText}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                          HorizontalAlignment="Center">
                <ItemsControl ItemsSource="{Binding SuggestedPrompts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Command="{Binding DataContext.UseSuggestionCommand, ElementName=Root}"
                              CommandParameter="{Binding}" FontSize="11" Padding="10,5" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnMessageScrollChanged">
              <ItemsControl ItemsSource="{Binding FilteredMessages}" Margin="10,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChatUiMessage">
                    <StackPanel Margin="0,4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <SelectableTextBlock Text="{Binding RoleLabel}" FontWeight="SemiBold" SelectionBrush="#6680c0"
                                   Foreground="{Binding IsUser, Converter={StaticResource BoolToRoleBrush}}" />
                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource GuiThinkingLabel}"
                                   IsVisible="{Binding IsThinking}" />
                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource GuiToolLabel}"
                                   IsVisible="{Binding IsToolCall}" />
                        <SelectableTextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" SelectionBrush="#6680c0"
                                   Foreground="{DynamicResource GuiMutedText}" FontSize="11" />
                        <TextBlock Text="●" Foreground="{DynamicResource GuiBusyText}" FontSize="10"
                                   IsVisible="{Binding IsStreaming}" ToolTip.Tip="输出中" />
                        <Button Content="⧉" FontSize="10" Padding="3,1" Background="Transparent"
                                BorderThickness="0" Foreground="{DynamicResource GuiMutedText}"
                                Command="{Binding DataContext.CopyMessageCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Button Content="✕" FontSize="10" Padding="3,1" Background="Transparent"
                                BorderThickness="0" Foreground="{DynamicResource GuiErrorText}"
                                Tag="{Binding}"
                                Click="OnRemoveClick" />
                      </StackPanel>
                      <md:MarkdownView Markdown="{Binding DisplayText}"
                                       BaseFontSize="{Binding DataContext.FontSize, ElementName=Root}"
                                       IsVisible="{Binding ShowBody}"
                                       Opacity="{Binding IsThinking, Converter={StaticResource BoolToThinkingOpacity}}" />
                      <StackPanel IsVisible="{Binding IsToolCall}" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <SelectableTextBlock Text="{Binding ToolName}" SelectionBrush="#6680c0" FontWeight="SemiBold" Foreground="{DynamicResource GuiToolLabel}" FontSize="12" />
                          <TextBlock Text="{Binding ToolElapsedText}" Foreground="{DynamicResource GuiBusyText}" FontSize="11"
                                     IsVisible="{Binding IsToolRunning}" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding ToolArguments}" SelectionBrush="#6680c0" Foreground="{DynamicResource GuiToolArgument}" FontSize="11" FontFamily="Consolas"
                                   TextWrapping="Wrap" IsVisible="{Binding IsToolCallStart}" />
                        <SelectableTextBlock Text="{Binding ToolResultText}" SelectionBrush="#6680c0" Foreground="{DynamicResource GuiToolResult}" FontSize="11"
                                   TextWrapping="Wrap" IsVisible="{Binding IsToolResultMessage}" />
                        <md:DiffViewer Hunks="{Binding StructuredPatch}" IsVisible="{Binding HasDiff}" Margin="0,4,0,0" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10" CornerRadius="12"
                    Padding="14,6" Background="#4a9eff" IsVisible="{Binding HasCopied}">
              <TextBlock Text="已复制到剪贴板" Foreground="White" FontSize="12" />
            </Border>
            <Border x:Name="ErrorToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,52"
                    CornerRadius="10" Padding="14,8" Background="#d43a3a" Opacity="0"
                    IsVisible="{Binding HasErrorToast}" ZIndex="10"
                    PointerEntered="OnErrorToastPointerEnter" PointerExited="OnErrorToastPointerLeave">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                </Transitions>
              </Border.Transitions>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock x:Name="ErrorToastTextBlock" Text="{Binding ErrorToastText}" Foreground="White"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="📋 复制" FontSize="11" Padding="8,3"
                          Command="{Binding CopyErrorToastCommand}" />
                  <Button Content="✕" FontSize="10" Padding="5,2" Background="Transparent"
                          BorderThickness="0" Foreground="White"
                          Command="{Binding DismissErrorToastCommand}" />
                </StackPanel>
              </Grid>
            </Border>
            <Button x:Name="BackToBottomButton" Content="↓ 跳到最新" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,0,12" FontSize="11" Padding="12,6"
                    IsVisible="False" Background="{DynamicResource GuiSessionHighlight}" Click="OnBackToBottomClick" />
          </Panel>
        </Grid>

        <!-- Column 1：设置面板 -->
        <Border Grid.Column="1" Background="{DynamicResource GuiSettingsBackground}" Padding="12"
                IsVisible="{Binding IsSettingsPanelOpen}" ClipToBounds="True">
          <StackPanel Spacing="12">
            <TextBlock Text="对话设置" FontWeight="SemiBold" Foreground="{DynamicResource GuiPrimaryText}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Temperature, StringFormat='{}温度 {0:0.0}'}" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" />
              <Slider Minimum="0" Maximum="2" Value="{Binding Temperature}" TickFrequency="0.1" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding MaxTokens, StringFormat='{}最大长度 {0}'}" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" />
              <Slider Minimum="256" Maximum="32768" Value="{Binding MaxTokens}" TickFrequency="256" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding FontSize, StringFormat='{}消息字号 {0:0}'}" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" />
              <Slider Minimum="11" Maximum="20" Value="{Binding FontSize}" TickFrequency="1" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="流式输出" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" VerticalAlignment="Center" />
              <ToggleButton IsChecked="{Binding StreamingEnabled}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="推理力度" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" />
              <ComboBox ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding SelectedEffort}"
                        HorizontalAlignment="Stretch" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="系统提示词" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" />
              <TextBox Text="{Binding SystemPrompt}" AcceptsReturn="True" MaxLines="4"
                       TextWrapping="Wrap" FontSize="11" />
            </StackPanel>
            <Border Height="1" Background="{DynamicResource GuiDivider}" />
            <TextBlock Text="快捷操作" FontWeight="SemiBold" Foreground="{DynamicResource GuiPrimaryText}" />
            <Button Content="插入分隔线" Command="{Binding InsertDividerCommand}" />
            <Button Content="插入时间戳" Command="{Binding InsertTimestampCommand}" />
            <Button Content="↺ 恢复默认" Command="{Binding ResetSettingsCommand}" FontSize="11" />
            <Border Height="1" Background="{DynamicResource GuiDivider}" />
            <TextBlock Text="快捷键" FontWeight="SemiBold" Foreground="{DynamicResource GuiPrimaryText}" />
            <TextBlock Text="Ctrl+N 新建 · Ctrl+L 清空 · Esc 收起/停止"
                       Foreground="{DynamicResource GuiMutedText}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 2：底部输入栏 -->
      <Border Grid.Row="2" Padding="10" Background="{DynamicResource GuiInputBarBackground}" ClipToBounds="True">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox x:Name="InputTextBox" Text="{Binding InputText}" Watermark="输入消息，Enter 发送 / Shift+Enter 换行…"
                     IsEnabled="{Binding !IsBusy}" AcceptsReturn="True" MaxLines="5"
                     TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Foreground="{Binding IsInputTooLong, Converter={StaticResource BoolToWarnBrush}}"
                       FontSize="11" VerticalAlignment="Bottom" Margin="8,0"
                       ToolTip.Tip="{Binding MaxInputChars, StringFormat='{}建议上限 {0} 字符'}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{} {0} / {1}">
                  <Binding Path="CharsCount" />
                  <Binding Path="MaxInputChars" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Content="停止" Command="{Binding StopGeneratingCommand}" IsVisible="{Binding CanStop}" />
              <Button Content="发送" Command="{Binding SendCommand}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
          </Grid>

          <!-- 斜杠命令补全面板（Placement=Top 上方弹出贴边，SharedSizeGroup 跨项对齐命令名列） -->
          <Popup x:Name="SlashPopup"
                 PlacementTarget="{Binding ElementName=InputTextBox}"
                 Placement="Top" IsOpen="{Binding IsSlashPopupOpen}"
                 VerticalOffset="0" IsLightDismissEnabled="True">
            <Border x:Name="SlashPopupBorder" MinWidth="300" MaxHeight="340" CornerRadius="6" Padding="2"
                    Background="{DynamicResource GuiWindowBackground}"
                    BoxShadow="0 6 16 0 #90000000" ClipToBounds="True">
              <ListBox x:Name="SlashListBox"
                       ItemsSource="{Binding SlashSuggestions}"
                       SelectedIndex="{Binding SlashSelectedIndex}"
                       Background="Transparent" Padding="1"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       Grid.IsSharedSizeScope="True">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SlashCommandItem">
                    <Grid Margin="8,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="CmdNameCol" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" Spacing="0" Grid.Column="0">
                        <TextBlock Text="{Binding MatchedPart}" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="#E89A3C" />
                        <TextBlock Text="{Binding RemainingPart}" FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource GuiSecondaryText}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11"
                                 Foreground="{DynamicResource GuiMutedText}"
                                 TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                 ToolTip.Tip="{Binding Usage}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Popup>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="─ 分隔线" Command="{Binding InsertDividerCommand}" FontSize="11" Padding="8,3" />
            <Button Content="⏱ 时间戳" Command="{Binding InsertTimestampCommand}" FontSize="11" Padding="8,3" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Row 3：状态栏 -->
      <Border Grid.Row="3" Padding="12,4" Background="{DynamicResource GuiStatusBarBackground}">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <TextBlock Text="{Binding Sessions.Count, StringFormat='{}会话 {0}'}" Foreground="{DynamicResource GuiMutedText}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="{Binding MessageCount, StringFormat='{}  · 消息 {0}'}"
                     Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="10,0" />
          <TextBlock Grid.Column="3" Text="{Binding SelectedModel}" Foreground="{DynamicResource GuiAccentText}" FontSize="11"
                     TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

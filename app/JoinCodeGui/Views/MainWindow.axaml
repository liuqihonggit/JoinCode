<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
        xmlns:vm="using:JoinCode.Gui.ViewModels"
        xmlns:md="using:JoinCode.Gui.Markdown"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:local="using:JoinCode.Gui.Views"
        x:Class="JoinCode.Gui.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        MinWidth="800" MinHeight="600"
        Title="JoinCode Ava">
  <Window.Styles>
    <Style Selector="local|MainWindow Button">
      <Setter Property="Background" Value="{DynamicResource GuiButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GuiButtonBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource GuiButtonForeground}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Name="root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="local|MainWindow Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource GuiButtonHover}" />
    </Style>
    <Style Selector="local|MainWindow Button:pressed">
      <Setter Property="Background" Value="{DynamicResource GuiButtonPressed}" />
    </Style>
    <Style Selector="local|MainWindow Button:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </Window.Styles>

  <!-- 根 Grid：侧边栏(*) : 主区(4*) 比例对齐 -->
  <Grid ColumnDefinitions="*,4*">

    <!-- ===== Column 0：侧边栏 ===== -->
    <local:SidebarView Grid.Column="0" />

    <!-- ===== Column 1：主区 ===== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">

      <!-- Row 0：顶部工具栏 -->
      <local:TopBarView Grid.Row="0" />

      <!-- Row 1：消息区（消息内容(*) : 设置面板(Auto)） -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ClipToBounds="True">

        <!-- Column 0：消息内容（搜索栏 + 消息列表） -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
          <!-- 搜索栏 -->
          <Border Grid.Row="0" Padding="10,6" Background="{DynamicResource GuiSearchBarBackground}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
              <TextBox Text="{Binding SearchText}" Watermark="搜索消息…" FontSize="12" Padding="6,2"
                       VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text=" 🔍" VerticalAlignment="Center"
                         IsVisible="{Binding IsSearching}" />
              <TextBlock Grid.Column="2" Text="{Binding MessageCount, StringFormat='{} 消息 {0}'}"
                         Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" Margin="14,0" />
              <TextBlock Grid.Column="3" Text="{Binding EstimatedTokens, StringFormat='{} 约 {0} tokens'}"
                         Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding TotalChars, StringFormat='{} {0} 字符'}"
                         Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" Margin="14,0" />
              <Button Grid.Column="5" Content="⧉ 导出" Command="{Binding CopySessionExportCommand}"
                      FontSize="11" Padding="8,3" IsEnabled="{Binding HasMessages}"
                      ToolTip.Tip="复制会话为文本" />
            </Grid>
          </Border>
          <!-- 消息列表区 -->
          <Panel Grid.Row="1" ClipToBounds="True">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                        IsVisible="{Binding !HasMessages}">
              <TextBlock Text="👋" FontSize="40" HorizontalAlignment="Center" />
              <TextBlock Text="开始与 JoinCode 对话" FontSize="18" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Foreground="{DynamicResource GuiPrimaryText}" />
              <TextBlock Text="在下方输入消息，Enter 发送" FontSize="13"
                         HorizontalAlignment="Center" Foreground="{DynamicResource GuiMutedText}" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                          HorizontalAlignment="Center">
                <ItemsControl ItemsSource="{Binding SuggestedPrompts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Command="{Binding DataContext.UseSuggestionCommand, ElementName=Root}"
                              CommandParameter="{Binding}" FontSize="11" Padding="10,5" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
            <edit:TextEditor x:Name="MessageTextEditor"
                             IsReadOnly="True" ShowLineNumbers="False" WordWrap="True"
                             FontFamily="{DynamicResource GuiMonoFont}" FontSize="{Binding FontSize}"
                             Foreground="{DynamicResource GuiEditorForeground}" Background="Transparent" BorderThickness="0"
                             Padding="10,6" />
            <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10" CornerRadius="12"
                    Padding="14,6" Background="{DynamicResource GuiToastSuccess}" IsVisible="{Binding HasCopied}">
              <TextBlock Text="已复制到剪贴板" Foreground="{DynamicResource GuiToastForeground}" FontSize="12" />
            </Border>
            <Border x:Name="ErrorToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,52"
                    CornerRadius="10" Padding="14,8" Background="{DynamicResource GuiToastError}" Opacity="0"
                    IsVisible="{Binding HasErrorToast}" ZIndex="10"
                    PointerEntered="OnErrorToastPointerEnter" PointerExited="OnErrorToastPointerLeave">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                </Transitions>
              </Border.Transitions>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock x:Name="ErrorToastTextBlock" Text="{Binding ErrorToastText}" Foreground="{DynamicResource GuiToastForeground}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="📋 复制" FontSize="11" Padding="8,3"
                          Command="{Binding CopyErrorToastCommand}" />
                  <Button Content="✕" FontSize="10" Padding="5,2" Background="Transparent"
                          BorderThickness="0" Foreground="{DynamicResource GuiToastForeground}"
                          Command="{Binding DismissErrorToastCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </Panel>
          <Button Grid.Row="2" x:Name="BackToBottomButton" Content="↓ 跳到最新"
                  HorizontalAlignment="Center" FontSize="11" Padding="12,6"
                  IsVisible="{Binding IsBackToBottomVisible}" Background="{DynamicResource GuiSessionHighlight}"
                  Command="{Binding ScrollToBottomCommand}" />
        </Grid>

        <!-- Column 1：设置面板 -->
        <local:SettingsPanelView Grid.Column="1" IsVisible="{Binding IsSettingsPanelOpen}" ClipToBounds="True" />
      </Grid>

      <!-- Row 2：底部输入栏 -->
      <local:InputBarView Grid.Row="2" x:Name="InputBar" />

      <!-- Row 3：状态栏 -->
      <Border Grid.Row="3" Padding="12,4" Background="{DynamicResource GuiStatusBarBackground}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <TextBlock Text="{Binding Sessions.Count, StringFormat='{}会话 {0}', FallbackValue='会话 0'}" Foreground="{DynamicResource GuiMutedText}" FontSize="11" />
          <TextBlock Grid.Column="1" Text="{Binding MessageCount, StringFormat='{}  · 消息 {0}', FallbackValue='  · 消息 0'}"
                     Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="10,0" />
          <TextBlock Grid.Column="2" Text="{Binding TokenUsageText, FallbackValue=''}"
                     Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="10,0,0,0" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
            <TextBlock x:Name="StatusDot" Text="●" FontSize="12" Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText, FallbackValue='未连接'}" Foreground="{DynamicResource GuiSecondaryText}" FontSize="11" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="5" Text="{Binding SelectedModel, FallbackValue=''}" Foreground="{DynamicResource GuiAccentText}" FontSize="11"
                     TextTrimming="CharacterEllipsis" Margin="10,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

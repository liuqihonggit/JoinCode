<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
              x:Class="JoinCode.Gui.Views.SettingsPanelView"
              x:Name="Root"
              x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <!-- 设置卡片：圆角 10 分组容器 -->
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource GuiSearchBarBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.settingsCard TextBlock.cardTitle">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource GuiSecondaryText}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- 滑杆参数行：标签左 / 数值右（accent 强调） -->
    <Style Selector="Slider">
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </UserControl.Styles>

  <!-- 右侧抽屉：固定宽 280，左边框分隔（Padding 12 对齐全局栏节奏） -->
  <Border Width="282" Background="{DynamicResource GuiSettingsBackground}"
          BorderBrush="{DynamicResource GuiDivider}" BorderThickness="1,0,0,0"
          Padding="12,12" ClipToBounds="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <!-- 头部：标题 + 关闭 -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource GuiAccentText}" VerticalAlignment="Center" />
            <TextBlock Text="设置" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource GuiPrimaryText}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="ghost" Grid.Column="1" Content="✕" FontSize="11" Padding="6,3" MinHeight="0"
                  Command="{Binding ToggleSettingsPanelCommand}" ToolTip.Tip="收起设置面板" />
        </Grid>

        <!-- 对话参数 -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardTitle" Text="对话参数" />
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="温度" FontSize="11.5" Foreground="{DynamicResource GuiMutedText}" />
                <TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat='{}{0:0.0}'}"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentText}" />
              </Grid>
              <Slider Minimum="0" Maximum="2" Value="{Binding Temperature}" TickFrequency="0.1" />
            </StackPanel>
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="最大长度" FontSize="11.5" Foreground="{DynamicResource GuiMutedText}" />
                <TextBlock Grid.Column="1" Text="{Binding MaxTokens, StringFormat='{}{0}'}"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentText}" />
              </Grid>
              <Slider Minimum="256" Maximum="32768" Value="{Binding MaxTokens}" TickFrequency="256" />
            </StackPanel>
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="消息字号" FontSize="11.5" Foreground="{DynamicResource GuiMutedText}" />
                <TextBlock Grid.Column="1" Text="{Binding FontSize, StringFormat='{}{0:0}'}"
                           FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentText}" />
              </Grid>
              <Slider Minimum="11" Maximum="20" Value="{Binding FontSize}" TickFrequency="1" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 生成行为 -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardTitle" Text="生成行为" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="流式输出" FontSize="11.5" Foreground="{DynamicResource GuiMutedText}" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding StreamingEnabled}" MinHeight="0" Padding="0" />
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Text="推理力度" FontSize="11.5" Foreground="{DynamicResource GuiMutedText}" />
              <ComboBox ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding SelectedEffort}"
                        HorizontalAlignment="Stretch" FontSize="12" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 快捷键面板（F3 / 需求3） -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="10">
            <TextBlock Classes="cardTitle" Text="快捷键" />
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="Enter 直接发送" FontSize="11.5" Foreground="{DynamicResource GuiPrimaryText}" />
                <TextBlock Text="关闭时：Ctrl+Enter 发送，Enter 换行" FontSize="10.5"
                           Foreground="{DynamicResource GuiMutedText}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnterSends}" MinHeight="0" Padding="0" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="双击 ESC 终止对话" FontSize="11.5" Foreground="{DynamicResource GuiPrimaryText}" />
                <TextBlock Text="600ms 内两次 ESC，仅断开对话网络" FontSize="10.5"
                           Foreground="{DynamicResource GuiMutedText}" TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding DoubleEscStop}" MinHeight="0" Padding="0" />
            </Grid>
            <!-- 快捷键列表（可录制键位） — 需求3 -->
            <ItemsControl ItemsSource="{Binding HotkeyItems}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HotkeyItemVm">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding ActionLabel}" FontSize="11.5" Foreground="{DynamicResource GuiPrimaryText}" />
                      <TextBlock Text="{Binding Gesture}" FontSize="10.5" Foreground="{DynamicResource GuiMutedText}"
                                 IsVisible="{Binding !IsRecording}" />
                      <TextBlock Text="按下键组合…" FontSize="10.5" Foreground="{DynamicResource GuiAccentText}"
                                 IsVisible="{Binding IsRecording}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Content="录制" FontSize="10" Padding="6,2" MinHeight="0"
                            IsVisible="{Binding !IsRecording}"
                            Command="{Binding DataContext.ToggleHotkeyRecordingCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="1" Classes="ghost" Content="停止" FontSize="10" Padding="6,2" MinHeight="0"
                            Foreground="{DynamicResource GuiWarnText}"
                            IsVisible="{Binding IsRecording}"
                            Command="{Binding DataContext.ToggleHotkeyRecordingCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Classes="ghost" Content="↺" FontSize="10" Padding="4,2" MinHeight="0"
                            ToolTip.Tip="恢复默认"
                            Command="{Binding DataContext.ResetHotkeyCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 系统提示词 -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="6">
            <TextBlock Classes="cardTitle" Text="系统提示词" />
            <TextBox Text="{Binding SystemPrompt}" AcceptsReturn="True" MaxLines="4"
                     TextWrapping="Wrap" FontSize="11" />
          </StackPanel>
        </Border>

        <!-- 快捷操作 -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="8">
            <TextBlock Classes="cardTitle" Text="快捷操作" />
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
              <Button Classes="ghost" Content="─ 分隔线" FontSize="11" Padding="8,4" MinHeight="0"
                      HorizontalAlignment="Stretch" Command="{Binding InsertDividerCommand}" />
              <Button Classes="ghost" Grid.Column="1" Content="⏱ 时间戳" FontSize="11" Padding="8,4" MinHeight="0"
                      HorizontalAlignment="Stretch" Command="{Binding InsertTimestampCommand}" />
              <Button Classes="ghost" Grid.Column="2" Content="↺ 默认" FontSize="11" Padding="8,4" MinHeight="0"
                      Foreground="{DynamicResource GuiWarnText}"
                      Command="{Binding ResetSettingsCommand}" ToolTip.Tip="恢复默认设置" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 快捷键提示 -->
        <TextBlock Text="快捷键：Ctrl+N 新建 · Ctrl+L 清空 · Esc 收起/停止"
                   Foreground="{DynamicResource GuiMutedText}" FontSize="10.5" TextWrapping="Wrap"
                   Margin="2,0,0,2" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
             xmlns:local="using:JoinCode.Gui.Views"
             x:Class="JoinCode.Gui.Views.SidebarView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <!-- 会话卡片：圆角 8，悬停浮起，选中高亮（类名驱动，替代转换器绑定以便悬停态生效） -->
    <Style Selector="Border.sessionItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sessionItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource GuiButtonHover}" />
    </Style>
    <Style Selector="Border.sessionItem.selected">
      <Setter Property="Background" Value="{DynamicResource GuiSessionHighlight}" />
    </Style>
    <!-- 删除按钮：默认隐藏，卡片悬停显现 -->
    <Style Selector="Border.sessionItem Button.closeBtn">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.sessionItem:pointerover Button.closeBtn">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource GuiSidebarBackground}" ClipToBounds="True">
    <!-- 头部 -->
    <StackPanel Grid.Row="0" Spacing="12" Margin="12,14,12,4">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="◆" FontSize="17" Foreground="{DynamicResource GuiAccentText}" VerticalAlignment="Center" />
        <TextBlock Text="JoinCode Ava" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource GuiSidebarTitle}" VerticalAlignment="Center" />
      </StackPanel>
      <Button Classes="accentSubtle" Content="＋ 新建对话" Command="{Binding NewConversationCommand}"
              CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,6" />
    </StackPanel>
    <!-- 会话列表 -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,4">
      <StackPanel>
        <TextBlock Text="会话列表" Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="18,0,0,6" />
        <ItemsControl ItemsSource="{Binding Sessions}" Margin="8,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionItem">
              <Border Classes="sessionItem"
                      Classes.selected="{Binding IsSelected}"
                      DoubleTapped="OnSessionDoubleTapped"
                      Tapped="OnSessionSingleTapped"
                      Cursor="Hand">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="💬" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource GuiPrimaryText}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding !IsRenaming}" />
                    <TextBox Text="{Binding RenameDraft}" FontSize="12" Padding="2,0" MinHeight="0"
                             IsVisible="{Binding IsRenaming}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ViewModel.CommitRenameSessionCommand, RelativeSource={RelativeSource AncestorType=local:SidebarView}}" CommandParameter="{Binding}" />
                        <KeyBinding Gesture="Escape" Command="{Binding ViewModel.CancelRenameSessionCommand, RelativeSource={RelativeSource AncestorType=local:SidebarView}}" CommandParameter="{Binding}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="closeBtn ghost" Content="✕" FontSize="9" Padding="4,2" MinHeight="0"
                          Foreground="{DynamicResource GuiMutedText}"
                          Command="{Binding ViewModel.RemoveSessionCommand, RelativeSource={RelativeSource AncestorType=local:SidebarView}}"
                          CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <!-- 底部状态：绑定真实引擎状态（StatusText/StatusKind），与主窗口状态栏同源 -->
    <Border Grid.Row="2" Padding="14,10" Background="{DynamicResource GuiStatusBarBackground}"
            BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="●" FontSize="10" Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusText, FallbackValue='未连接'}" FontSize="11"
                   Foreground="{DynamicResource GuiMutedText}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
             x:Class="JoinCode.Gui.Views.TopBarView"
             x:DataType="vm:MainViewModel">
  <Border Padding="10,8" Background="{DynamicResource GuiTopBarBackground}" ClipToBounds="True">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,*,Auto,Auto" ColumnSpacing="10">
      <ToggleButton Content="🌙" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="切换深浅主题" />
      <Button Grid.Column="1" Content="↻ 重新生成" Command="{Binding RegenerateLastReplyCommand}"
              IsEnabled="{Binding CanRegenerate}" FontSize="11" ToolTip.Tip="撤回上一轮并重新生成" />
      <Button Grid.Column="2" Content="🗑 清空" Command="{Binding ClearHistoryCommand}"
              IsEnabled="{Binding HasMessages}" />
      <Button Grid.Column="3" Content="⊘ 全部重置" Command="{Binding ClearAllSessionsCommand}"
              FontSize="11" />
      <ComboBox Grid.Column="4" ItemsSource="{Binding ConnectionOptions}" SelectedItem="{Binding SelectedConnection}"
                IsVisible="{Binding IsEngineLoaded}"
                HorizontalAlignment="Stretch" ToolTip.Tip="当前供应商（从 models.json 读取）">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConnectionOptionItem">
            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Grid.Column="5" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModelOption}"
                IsVisible="{Binding IsEngineLoaded}"
                PlaceholderText="选择模型" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ModelOptionItem">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding ModalityTags}" FontSize="10" VerticalAlignment="Center"
                         IsVisible="{Binding ModalityTags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ToggleButton Grid.Column="6" Content="🧪" Command="{Binding ToggleMockCommand}"
                    IsChecked="{Binding IsMockConnection, Mode=OneWay}"
                    ToolTip.Tip="切换 Mock 演示引擎（本地验证用）" />
      <Button Grid.Column="7" Content="⛭" ToolTip.Tip="设置面板" Command="{Binding ToggleSettingsPanelCommand}" />
    </Grid>
  </Border>
</UserControl>

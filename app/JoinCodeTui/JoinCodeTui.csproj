<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>JoinCode.Tui</RootNamespace>
    <AssemblyName>jcctui</AssemblyName>
    <Description>JoinCode TUI 终端界面（独立 exe，不走 CLI 管道）</Description>
    <NoWarn>$(NoWarn);JCC9001;CS8604;CS1573;CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用 JoinCode 复用 EngineSessionFactory + Abstractions 门面；TUI 不走 CLI 管道，用 CreateGuiSessionAsync 组装 DI -->
    <ProjectReference Include="$(RepoRoot)app\JoinCode\JoinCode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [EnumValue] 源码生成器 — TUI 枚举(ToolBarAction/FooterTab等)生成 XxxConstants -->
    <ProjectReference Include="$(RepoRoot)generators\EnumMetadata.Generator\src\EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 调试用：引用本地 Terminal.Gui 源码（.xxx/Terminal.Gui），可步入框架代码定位性能瓶颈 -->
    <!-- 恢复 NuGet 包时改回: <PackageReference Include="Terminal.Gui" Version="2.4.17" /> -->
    <ProjectReference Include="$(RepoRoot)libs\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj" Condition="Exists('$(RepoRoot)libs\Terminal.Gui\Terminal.Gui\Terminal.Gui.csproj')" />
    <!-- EditorView — rope-backed 文本编辑器，支持选择/复制/软换行；引用本地源码可调试 -->
    <ProjectReference Include="$(RepoRoot)libs\Editor\src\Terminal.Gui.Editor\Terminal.Gui.Editor.csproj" Condition="Exists('$(RepoRoot)libs\Editor\src\Terminal.Gui.Editor\Terminal.Gui.Editor.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Host.Tests" />
    <InternalsVisibleTo Include="JoinCode.Tui.Tests" />
  </ItemGroup>

</Project>

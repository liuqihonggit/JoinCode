<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:Dock.Model.Core"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
             x:Class="JoinCode.Gui.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/Default.axaml" />
        <ResourceDictionary>
          <ControlRecycling x:Key="ControlRecyclingKey" />
        </ResourceDictionary>
        <ResourceDictionary>
          <Dock x:Key="DockDocumentTabStripHorizontalCreateButtonDock">Left</Dock>
          <HorizontalAlignment x:Key="DockDocumentTabStripHorizontalCreateButtonAlignment">Left</HorizontalAlignment>
        </ResourceDictionary>
        <ResourceDictionary>
          <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key='Default'>
              <Color x:Key="RegionColor">#FFFAFAFA</Color>
              <Color x:Key="AcrylicFallbackColor">#E2E2E2</Color>
            </ResourceDictionary>
            <ResourceDictionary x:Key='Dark'>
              <Color x:Key="RegionColor">#FF212121</Color>
              <Color x:Key="AcrylicFallbackColor">#1F1F1F</Color>
            </ResourceDictionary>
          </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <DockFluentTheme DensityStyle="Normal" />
    <Style Selector="DockControl">
      <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource ControlRecyclingKey}" />
    </Style>
    <Style Selector="DocumentControl">
      <Setter Property="IconTemplate">
        <DataTemplate DataType="core:IDockable">
          <PathIcon
            Data="M5 1C3.89543 1 3 1.89543 3 3V13C3 14.1046 3.89543 15 5 15H11C12.1046 15 13 14.1046 13 13V5.41421C13 5.01639 12.842 4.63486 12.5607 4.35355L9.64645 1.43934C9.36514 1.15804 8.98361 1 8.58579 1H5ZM4 3C4 2.44772 4.44772 2 5 2H8V4.5C8 5.32843 8.67157 6 9.5 6H12V13C12 13.5523 11.5523 14 11 14H5C4.44772 14 4 13.5523 4 13V3ZM11.7929 5H9.5C9.22386 5 9 4.77614 9 4.5V2.20711L11.7929 5Z"
            Width="16" Height="16" Margin="0" Padding="0,0,2,0" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="DocumentControl">
      <Setter Property="HeaderTemplate">
        <DataTemplate DataType="core:IDockable">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="🌿" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Padding="2" />
            <ToggleButton x:Name="BadgeBtn" Padding="4,1" MinHeight="0" FontSize="10"
                          Background="{DynamicResource GuiAccentText}" Foreground="White"
                          CornerRadius="8" VerticalAlignment="Center" Margin="0"
                          Content="{ReflectionBinding Session.SubSessionCount}"
                          IsVisible="{ReflectionBinding Session.HasChildren}" />
            <Popup IsOpen="{Binding #BadgeBtn.IsChecked, Mode=TwoWay}"
                   PlacementTarget="{Binding #BadgeBtn}"
                   Placement="BottomEdgeAlignedLeft"
                   HorizontalOffset="0" VerticalOffset="2">
              <Border Background="{DynamicResource GuiCardBackground}"
                      BorderBrush="{DynamicResource GuiDivider}" BorderThickness="1"
                      CornerRadius="4" Padding="2" MinWidth="160" MaxWidth="280">
                <ItemsControl ItemsSource="{ReflectionBinding Session.Children}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SessionItem">
                      <Button Content="{Binding Title}" FontSize="11" Padding="8,4" MinHeight="0"
                              HorizontalAlignment="Stretch"
                              Command="{ReflectionBinding $parent[ItemsControl].DataContext.SelectSubSessionCommand}"
                              CommandParameter="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Popup>
          </StackPanel>
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="ToolControl">
      <Setter Property="HeaderTemplate">
        <DataTemplate DataType="core:IDockable">
          <TextBlock Text="{Binding Title}" Padding="2" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="ToolChromeControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ProportionalStackPanelSplitter">
      <Setter Property="Background" Value="{DynamicResource GuiDivider}" />
      <Setter Property="Thickness" Value="6" />
    </Style>
  </Application.Styles>
</Application>

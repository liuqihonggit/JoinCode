<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="JoinCode.Gui.Views.AskUserQuestionDialog"
        Title="用户确认"
        MinWidth="420" MaxWidth="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource GuiWindowBackground}">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="HeaderBlock"
               FontSize="15" FontWeight="SemiBold"
               Foreground="{DynamicResource GuiPrimaryText}"
               TextWrapping="Wrap" />
    <TextBlock x:Name="QuestionBlock"
               FontSize="13"
               Foreground="{DynamicResource GuiSecondaryText}"
               TextWrapping="Wrap" />
    <StackPanel x:Name="OptionsPanel" Spacing="6" />
    <TextBox x:Name="FreeInputBox"
             Watermark="自由输入..."
             IsVisible="False"
             FontSize="13"
             Foreground="{DynamicResource GuiPrimaryText}"
             Background="{DynamicResource GuiComposerBackground}"
             CornerRadius="8" Padding="10,8" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="取消" MinWidth="88" Padding="12,6" CornerRadius="8"
              Classes="ghost"
              x:Name="CancelButton" />
      <Button Content="确认" MinWidth="88" Padding="12,6" CornerRadius="8"
              Classes="primary"
              x:Name="ConfirmFreeInputButton"
              IsVisible="False" />
    </StackPanel>
  </StackPanel>
</Window>

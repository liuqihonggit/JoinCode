<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
             x:Class="JoinCode.Gui.Views.FileTreePanelView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*"
        Background="{DynamicResource GuiSidebarBackground}" ClipToBounds="True">
    <!-- 头部 -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="12,12,12,4">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="📂" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Text="目录树" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource GuiSidebarTitle}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding FileTreeRootPath, FallbackValue='未加载'}" FontSize="10"
                 Foreground="{DynamicResource GuiMutedText}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <!-- 目录树 — TreeView 自带滚动,无需外层 ScrollViewer -->
    <TreeView Grid.Row="1" ItemsSource="{Binding FileTreeItems}" Margin="4,4"
              Background="Transparent" BorderThickness="0"
              Tapped="OnTreeTapped">
      <TreeView.Styles>
        <!-- 绑定 TreeViewItem.IsExpanded → FileTreeItemVm.IsExpanded (TwoWay)
             展开时触发 VM 懒加载子节点 LoadChildren() -->
        <Style Selector="TreeViewItem" x:DataType="vm:FileTreeItemVm">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="6"
                        DoubleTapped="OnFileDoubleTapped">
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="在资源管理器中显示" Click="OnOpenInExplorer" />
                  <MenuItem Header="复制路径" Click="OnCopyPath" />
                  <MenuItem Header="复制相对路径" Click="OnCopyRelativePath" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <TextBlock Text="{Binding Icon}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource GuiPrimaryText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </Grid>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="680"
        xmlns:vm="using:JoinCode.Gui.ViewModels"
        xmlns:cnv="using:JoinCode.Gui.Converters"
        xmlns:sys="using:System"
        xmlns:abs="using:JoinCode.Abstractions.Interfaces"
        xmlns:md="using:JoinCode.Gui.Markdown"
        xmlns:controls="using:JoinCode.Gui.Views.Controls"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:local="using:JoinCode.Gui.Views"
        xmlns:design="using:JoinCode.Gui.Design"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:dockMvvm="using:Dock.Model.Mvvm.Controls"
        xmlns:dvm="using:JoinCode.Gui.ViewModels.Docking"
        x:Class="JoinCode.Gui.Views.MainWindow"
        x:Name="Root"
        d:DataContext="{x:Static design:DesignData.Sample}"
        x:DataType="vm:MainViewModel"
        MinWidth="800" MinHeight="600" Width="1080" Height="720"
        Background="{DynamicResource GuiWindowBackground}"
        Title="JoinCode · AI 编程工作区">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ToggleSidePanelCommand}" CommandParameter="{x:Static vm:SidePanelKind.Interceptor}" />
    <KeyBinding Gesture="Ctrl+G" Command="{Binding ToggleSidePanelCommand}" CommandParameter="{x:Static vm:SidePanelKind.Goal}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding StopGoalCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenQuickOpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding ToggleZenModeCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidePanelCommand}" CommandParameter="{x:Static vm:SidePanelKind.FileTree}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding TogglePanelCommand}" />
    <KeyBinding Gesture="Ctrl+OemBackslash" Command="{Binding ToggleSplitEditorCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding BackgroundPanel.PauseAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding BackgroundPanel.ResumeAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding BackgroundPanel.StopAllCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!-- 消息卡片：圆角 10，悬停换色 + 操作按钮悬停显现（GuiControlStyles 提供全局按钮基础样式） -->
    <Style Selector="Border.msgCard">
      <Setter Property="Background" Value="{DynamicResource GuiSearchBarBackground}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource GuiMotionDuration}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.msgCard:pointerover">
      <Setter Property="Background" Value="{DynamicResource GuiCardHover}" />
    </Style>
    <Style Selector="Border.msgCard StackPanel.actions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{DynamicResource GuiMotionDuration}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.msgCard:pointerover StackPanel.actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Activity Bar 图标按钮：40x40 圆角方块,透明背景,悬停浅色,激活强调色（Button+ToggleButton 统一,参考 QQ） -->
    <Style Selector="Button.activityIcon, ToggleButton.activityIcon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI Symbol, Inter" />
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Button.activityIcon:pointerover, ToggleButton.activityIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource GuiButtonHover}" />
    </Style>
    <Style Selector="Button.activityIcon:pressed, ToggleButton.activityIcon:pressed">
      <Setter Property="Background" Value="{DynamicResource GuiButtonPressed}" />
    </Style>
    <Style Selector="ToggleButton.activityIcon:checked">
      <Setter Property="Background" Value="{DynamicResource GuiAccentSubtle}" />
      <Setter Property="Foreground" Value="{DynamicResource GuiAccentText}" />
    </Style>
    <!-- Dock ToolControl 标题栏：显示 Title（含 emoji），tab 移到顶部 -->
    <Style Selector="ToolControl">
      <Setter Property="HeaderTemplate">
        <DataTemplate DataType="dockMvvm:Tool">
          <TextBlock Text="{Binding Title}" Padding="4,2" FontSize="12" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Inter" />
        </DataTemplate>
      </Setter>
    </Style>
    <!-- Dock ToolTabStrip 移到顶部（默认 Bottom） -->
    <Style Selector="ToolControl /template/ ToolTabStrip">
      <Setter Property="(DockPanel.Dock)" Value="Top" />
    </Style>
    <!-- Dock ToolChromeControl 透明背景融入侧边栏 -->
    <Style Selector="ToolChromeControl">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>

  <!-- 根 Grid：顶栏(横跨全宽) : 下区(侧边栏+主区) — 菜单栏在最顶,客户区不被侧边栏遮挡 -->
  <Grid RowDefinitions="Auto,*">

    <!-- ===== Row 0：顶部菜单栏(横跨全宽) ===== -->
    <local:TopBarView Grid.Row="0" IsVisible="{Binding IsNotZenMode}" />

    <!-- 命令面板 Overlay (Ctrl+Shift+P) — 居中浮在顶部 -->
    <Panel Grid.RowSpan="2" IsVisible="{Binding IsCommandPaletteOpen}" ZIndex="100">
      <local:CommandPaletteView HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" />
    </Panel>

    <!-- Diff 视图 Overlay — 居中浮在窗口中央 -->
    <Panel Grid.RowSpan="2" IsVisible="{Binding IsDiffViewOpen}" ZIndex="100">
      <Border Background="#80000000" />
      <local:DiffView HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Panel>

    <!-- ===== Row 1：Activity Bar + Side Bar + 主区 + Secondary Side Bar (VSCode 风格) ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="48,*">

    <!-- ===== Column 0：Activity Bar (图标列,固定48px) ===== -->
    <Border x:Name="ActivityBarCol" Grid.Column="0" Background="{DynamicResource GuiSidebarBackground}"
            BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,0,1,0"
            IsVisible="{Binding IsNotZenMode}">
      <Grid RowDefinitions="*,Auto,Auto">
        <!-- 顶部组：面板切换 -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,8" HorizontalAlignment="Center">
          <ToggleButton x:Name="SessionBtn" Classes="activityIcon" Content="💬" FontSize="20"
                        Command="{Binding ToggleSidePanelCommand}"
                        CommandParameter="{x:Static vm:SidePanelKind.Sessions}"
                        ToolTip.Tip="会话列表" />
          <ToggleButton x:Name="FileTreeBtn" Classes="activityIcon" Content="📁" FontSize="20"
                        Command="{Binding ToggleSidePanelCommand}"
                        CommandParameter="{x:Static vm:SidePanelKind.FileTree}"
                        ToolTip.Tip="目录树" />
          <ToggleButton x:Name="EditorBtn" Classes="activityIcon" Content="📝" FontSize="20"
                        Command="{Binding ToggleEditorViewCommand}"
                        ToolTip.Tip="代码编辑器" />
        </StackPanel>
        <!-- 中部组：功能面板(从左侧 SideBar 弹出) -->
        <StackPanel Grid.Row="1" Spacing="4" HorizontalAlignment="Center">
          <ToggleButton x:Name="GoalButton" Classes="activityIcon" Content="🎯" FontSize="20"
                        Command="{Binding ToggleSidePanelCommand}"
                        CommandParameter="{x:Static vm:SidePanelKind.Goal}"
                        ToolTip.Tip="goal 控制" />
          <ToggleButton x:Name="InterceptorButton" Classes="activityIcon" Content="🛡" FontSize="20"
                        Command="{Binding ToggleSidePanelCommand}"
                        CommandParameter="{x:Static vm:SidePanelKind.Interceptor}"
                        ToolTip.Tip="AI 工具拦截器" />
          <ToggleButton x:Name="ChatRoomButton" Classes="activityIcon" Content="👥" FontSize="20"
                        Command="{Binding ToggleSidePanelCommand}"
                        CommandParameter="{x:Static vm:SidePanelKind.ChatRoom}"
                        ToolTip.Tip="聊天室"
                        IsVisible="{Binding ChatRoomEnabled}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8" HorizontalAlignment="Center">
          <Button Classes="activityIcon" FontSize="20"
                  Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToggleToolTip}">
            <Panel>
              <TextBlock Text="🌙" FontSize="20" IsVisible="{Binding IsDarkTheme}" />
              <TextBlock Text="☀️" FontSize="20" IsVisible="{Binding !IsDarkTheme}" />
            </Panel>
          </Button>
          <ToggleButton x:Name="SettingsButton" Classes="activityIcon" Content="⚙" FontSize="20"
                        Command="{Binding ToggleSidePanelCommand}"
                        CommandParameter="{x:Static vm:SidePanelKind.Settings}"
                        ToolTip.Tip="设置" />
          <ToggleButton Classes="activityIcon" Content="⇥" FontSize="20"
                        IsChecked="{Binding IsSecondarySideBarOpen, Mode=TwoWay}"
                        ToolTip.Tip="Secondary Side Bar" />
          <Button Classes="activityIcon" FontSize="14"
                  Content="{Binding LanguageToggleDisplay}"
                  Command="{Binding ToggleLanguageCommand}"
                  ToolTip.Tip="中/En 切换语言" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Column 1：Dock.Avalonia 完整停靠布局（左面板+消息区，自带拖拽/分割/停靠） ===== -->
    <dock:DockControl Grid.Column="1" Layout="{Binding DockLayout}" />
    </Grid>
  </Grid>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
             xmlns:cnv="using:JoinCode.Gui.Converters"
             xmlns:abs="using:JoinCode.Abstractions.Interfaces"
             xmlns:controls="using:JoinCode.Gui.Views.Controls"
             xmlns:local="using:JoinCode.Gui.Views"
             x:Class="JoinCode.Gui.Views.StatusBarView"
             x:DataType="vm:MainViewModel">
  <Border x:Name="MainStatusBar" Height="30" Padding="12,0" Background="{DynamicResource GuiStatusBarBackground}"
          BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,1,0,0">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
      <!-- 全局运行状态区（T5）：状态圆点 + spinner 动词 + 耗时 + token 聚合 -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock x:Name="StatusDot" Text="●" FontSize="11" VerticalAlignment="Center" Classes.busyIndicator="{Binding IsBusy}"
                   Foreground="{Binding StatusKind, Converter={x:Static cnv:StatusToBrushConverter.Instance}}" />
        <Panel IsVisible="{Binding RunStatus.IsBusy}">
          <TextBlock Text="⟳" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource GuiAccentText}"
                     IsVisible="{Binding !RunStatus.IsStalled}" />
          <TextBlock Text="⟳" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                     Foreground="{DynamicResource GuiErrorText}"
                     IsVisible="{Binding RunStatus.IsStalled}" />
        </Panel>
        <TextBlock Text="{Binding RunStatus.Verb}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource GuiAccentText}" VerticalAlignment="Center"
                   IsVisible="{Binding RunStatus.IsBusy}" />
      </StackPanel>
      <!-- F1 走马灯 -->
      <controls:MarqueeTextBlock Grid.Column="5" Height="16" MinWidth="120" Margin="10,0" AnimationsEnabled="{Binding AnimationsEnabled}"
                                 Foreground="{DynamicResource GuiMutedText}"
                                 Text="{Binding RunStatus.MarqueeText, FallbackValue='JoinCode 就绪'}" />
      <!-- 后台代理 pill -->
      <Panel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
        <Button x:Name="BackgroundPill" Classes="pill" MinHeight="0" Padding="9,1"
                Background="{DynamicResource GuiAccentSubtle}"
                IsVisible="{Binding RunStatus.BackgroundPillText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Command="{Binding BackgroundPanel.ToggleAndRefreshCommand}">
          <TextBlock Text="{Binding RunStatus.BackgroundPillText}" Foreground="{DynamicResource GuiAccentText}"
                     FontSize="11" VerticalAlignment="Center" />
        </Button>
        <Popup IsOpen="{Binding BackgroundPanel.IsOpen}" Placement="Top" PlacementTarget="{Binding #BackgroundPill}"
               VerticalOffset="-6">
          <Border CornerRadius="10" Padding="12,8" Width="380" MaxHeight="320"
                  Background="{DynamicResource GuiPopupBackground}"
                  BorderBrush="{DynamicResource GuiDivider}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,2,6">
                <TextBlock Text="{Binding BackgroundPanel.CountText, FallbackValue='后台代理'}" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="{DynamicResource GuiPrimaryText}" VerticalAlignment="Center" />
                <TextBox Text="{Binding BackgroundPanel.SearchText}" Watermark="搜索..." FontSize="10" Padding="6,2" MinWidth="80" />
                <Button Classes="ghost" Content="暂停所有" FontSize="10" Padding="7,2" MinHeight="0"
                        Command="{Binding BackgroundPanel.PauseAllCommand}" ToolTip.Tip="暂停所有运行中子代理" />
                <Button Classes="ghost" Content="恢复所有" FontSize="10" Padding="7,2" MinHeight="0"
                        Command="{Binding BackgroundPanel.ResumeAllCommand}" ToolTip.Tip="恢复所有暂停中子代理" />
                <Button Classes="ghost" Content="终止所有" FontSize="10" Padding="7,2" MinHeight="0"
                        Command="{Binding BackgroundPanel.StopAllCommand}" ToolTip.Tip="终止所有运行中子代理" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" MaxHeight="270">
                <ItemsControl ItemsSource="{Binding BackgroundPanel.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackgroundAgentItemVm">
                      <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,5" Background="{DynamicResource GuiCardHover}"
                              IsVisible="{Binding IsVisible}">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <Button Classes="ghost" FontSize="10" Padding="4,2" MinHeight="0" MinWidth="0"
                                    Content="{Binding IsExpanded, Converter={x:Static cnv:ExpandGlyphConverter.Instance}}"
                                    ToolTip.Tip="展开/收起实时输出"
                                    Command="{Binding ViewModel.BackgroundPanel.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=local:StatusBarView}}"
                                    CommandParameter="{Binding AgentId}" />
                            <StackPanel Grid.Column="1" Spacing="2">
                              <TextBlock Text="{Binding Description}" FontSize="11.5" FontWeight="SemiBold"
                                         Foreground="{DynamicResource GuiPrimaryText}" TextTrimming="CharacterEllipsis" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{DynamicResource GuiAccentText}" />
                                <TextBlock Text="{Binding StateText}" FontSize="10.5" Foreground="{DynamicResource GuiMutedText}" />
                                <TextBlock Text="{Binding ElapsedText}" FontSize="10.5" Foreground="{DynamicResource GuiMutedText}" />
                                <TextBlock Text="{Binding StatsText}" FontSize="10.5" Foreground="{DynamicResource GuiMutedText}" />
                              </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding IsRunning}">
                              <Button Classes="ghost" Content="暂停" FontSize="10" Padding="7,2" MinHeight="0"
                                      IsVisible="{Binding CanPause}" ToolTip.Tip="暂停该子代理"
                                      Command="{Binding ViewModel.BackgroundPanel.PauseCommand, RelativeSource={RelativeSource AncestorType=local:StatusBarView}}"
                                      CommandParameter="{Binding AgentId}" />
                              <Button Classes="ghost" Content="继续" FontSize="10" Padding="7,2" MinHeight="0"
                                      IsVisible="{Binding CanResume}" ToolTip.Tip="恢复该子代理"
                                      Command="{Binding ViewModel.BackgroundPanel.ResumeCommand, RelativeSource={RelativeSource AncestorType=local:StatusBarView}}"
                                      CommandParameter="{Binding AgentId}" />
                              <Button Classes="ghost" Content="终止" FontSize="10" Padding="7,2" MinHeight="0"
                                      ToolTip.Tip="终止该后台代理"
                                      Command="{Binding ViewModel.BackgroundPanel.StopCommand, RelativeSource={RelativeSource AncestorType=local:StatusBarView}}"
                                      CommandParameter="{Binding AgentId}" />
                            </StackPanel>
                          </Grid>
                          <Border IsVisible="{Binding IsExpanded}" CornerRadius="4" Padding="8,4"
                                  Background="{DynamicResource GuiCardBackground}" Margin="4,0,0,0">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding LastActivityText, FallbackValue='无实时输出'}" FontSize="10"
                                         Foreground="{DynamicResource GuiMutedText}" TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding LastActivityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                              <ItemsControl ItemsSource="{Binding VisibleActivities}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="abs:AgentActivityEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                      <TextBlock Text="{Binding Glyph}" FontSize="10" Foreground="{DynamicResource GuiMutedText}" />
                                      <TextBlock Text="{Binding Text}" FontSize="10" Foreground="{DynamicResource GuiMutedText}"
                                                 TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Popup>
      </Panel>
      <TextBlock Grid.Column="2" Text="{Binding Sessions.Count, StringFormat='{}会话 {0}', FallbackValue='会话 0'}" Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="10,0,0,0" />
      <TextBlock Grid.Column="3" Text="{Binding MessageCount, StringFormat='{}  · 消息 {0}', FallbackValue='  · 消息 0'}"
                 Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="10,0" />
      <TextBlock Grid.Column="4" Text="{Binding TokenUsageText, FallbackValue=''}"
                 Foreground="{DynamicResource GuiMutedText}" FontSize="11" Margin="10,0,0,0" />
      <Border Grid.Column="6" CornerRadius="9" Padding="9,1" Margin="10,0,0,0"
              Background="{DynamicResource GuiAccentSubtle}" VerticalAlignment="Center"
              IsVisible="{Binding SelectedModel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding SelectedModel, FallbackValue=''}" Foreground="{DynamicResource GuiAccentText}" FontSize="11"
                   TextTrimming="CharacterEllipsis" MaxLines="1" />
      </Border>
    </Grid>
  </Border>
</UserControl>

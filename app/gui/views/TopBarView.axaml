<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
             x:Class="JoinCode.Gui.Views.TopBarView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <!-- VSCode 风格菜单栏 — 紧凑、无边框、悬停高亮 -->
    <Style Selector="Menu.vscodeMenu">
      <Setter Property="Background" Value="{DynamicResource GuiTopBarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GuiDivider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontFamily" Value="{DynamicResource FontFamily}" />
    </Style>
    <Style Selector="Menu.vscodeMenu > MenuItem">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </UserControl.Styles>

  <StackPanel>
    <!-- 第一行：Logo + VSCode 风格菜单栏(文件/编辑/视图/帮助) -->
    <Border Background="{DynamicResource GuiTopBarBackground}" BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="0">
        <TextBlock Text="◆" FontSize="14" Foreground="{DynamicResource GuiAccentText}"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
        <TextBlock Text="JoinCode" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource GuiPrimaryText}" VerticalAlignment="Center" Margin="6,0,0,0" />
        <Menu Classes="vscodeMenu" Margin="8,0,0,0">
          <MenuItem Header="文件">
            <MenuItem Header="文件 / 变更" Click="OnOpenFiles" />
            <MenuItem Header="模型 / MCP / 插件" Click="OnOpenManagement" />
          </MenuItem>
          <MenuItem Header="编辑">
            <MenuItem Header="↻ 重新生成" Command="{Binding RegenerateLastReplyCommand}" IsEnabled="{Binding CanRegenerate}" />
            <MenuItem Header="清空当前会话" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding HasMessages}" />
            <MenuItem Header="全部重置" Command="{Binding ClearAllSessionsCommand}" />
          </MenuItem>
          <MenuItem Header="视图">
            <MenuItem Header="切换主题" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToggleToolTip}" />
            <MenuItem Header="设置面板" Command="{Binding ToggleSettingsPanelCommand}" />
            <Separator />
            <MenuItem Header="Mock 引擎" Command="{Binding ToggleMockCommand}" IsChecked="{Binding IsMockConnection, Mode=OneWay}" />
            <MenuItem Header="无人值守" IsChecked="{Binding IsUnattendedMode, Mode=TwoWay}" ToolTip.Tip="{Binding UnattendedToggleToolTip}" />
          </MenuItem>
          <MenuItem Header="帮助">
            <MenuItem Header="快捷键" IsEnabled="False" />
            <MenuItem Header="关于 JoinCode" IsEnabled="False" />
          </MenuItem>
        </Menu>
      </StackPanel>
    </Border>

    <!-- 第二行：紧凑工具栏 — goal控制 + AI拦截器 + 设置(保留独立按钮因含 Popup) -->
    <Border Padding="12,4" Background="{DynamicResource GuiTopBarBackground}"
            BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,0,0,1" ClipToBounds="True">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
        <!-- 主题快速切换(保留顶栏便捷入口) -->
        <ToggleButton Grid.Column="0" Classes="ghost" Padding="7,3" FontSize="12"
                      Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToggleToolTip}">
          <Panel>
            <TextBlock Text="☾" FontFamily="Segoe UI Symbol" IsVisible="{Binding IsDarkTheme}" />
            <TextBlock Text="☀" FontFamily="Segoe UI Symbol" IsVisible="{Binding !IsDarkTheme}" />
          </Panel>
        </ToggleButton>
        <!-- Mock 快速切换 -->
        <ToggleButton Grid.Column="1" Classes="ghost" Padding="7,3" FontSize="11"
                      Command="{Binding ToggleMockCommand}"
                      IsChecked="{Binding IsMockConnection, Mode=OneWay}"
                      ToolTip.Tip="{Binding MockToggleToolTip}" Content="Ⓘ" />
        <!-- 中间弹性空隙 -->
        <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                   Foreground="{DynamicResource GuiMutedText}" VerticalAlignment="Center"
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <!-- 🎯 goal 进行中按钮 -->
        <Panel Grid.Column="3" VerticalAlignment="Center" IsVisible="{Binding IsGoalRunning}">
          <Button x:Name="GoalButton" Classes="ghost" Padding="7,3" FontSize="12"
                  ToolTip.Tip="goal 控制面板"
                  Command="{Binding ToggleGoalPanelCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🎯" />
              <TextBlock Text="goal" />
              <TextBlock Text="{Binding GoalProgressText, FallbackValue='进行中'}" FontSize="10"
                         Foreground="{DynamicResource GuiMutedText}"
                         IsVisible="{Binding GoalProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Button>
          <Popup IsOpen="{Binding IsGoalPanelOpen}" Placement="Bottom"
                 PlacementTarget="{Binding #GoalButton}" VerticalOffset="4">
            <Border CornerRadius="10" Padding="14,10" Width="300"
                    Background="{DynamicResource GuiPopupBackground}"
                    BorderBrush="{DynamicResource GuiDivider}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="🎯 goal 进行中" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource GuiPrimaryText}" />
                <TextBlock Text="停止时引擎自动注入再三确认提示词（a→b→c）" FontSize="10.5"
                           Foreground="{DynamicResource GuiMutedText}" TextWrapping="Wrap" />
                <Button Classes="ghost" Content="停止 goal" HorizontalAlignment="Stretch"
                        Command="{Binding StopGoalCommand}" />
              </StackPanel>
            </Border>
          </Popup>
        </Panel>
        <!-- AI 工具拦截器 -->
        <Panel Grid.Column="4" VerticalAlignment="Center">
          <Button x:Name="InterceptorButton" Classes="ghost" Padding="7,3" FontSize="12"
                  Content="🛡" ToolTip.Tip="AI 工具拦截器"
                  Command="{Binding ToggleInterceptorPanelCommand}" />
          <Popup IsOpen="{Binding IsInterceptorPanelOpen}" Placement="Bottom"
                 PlacementTarget="{Binding #InterceptorButton}" VerticalOffset="4">
            <Border CornerRadius="10" Padding="14,10" Width="300"
                    Background="{DynamicResource GuiPopupBackground}"
                    BorderBrush="{DynamicResource GuiDivider}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="🛡 AI 工具拦截器" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource GuiPrimaryText}" />
                <TextBlock Text="开启后 AI 调用对应工具会被拒绝" FontSize="10.5"
                           Foreground="{DynamicResource GuiMutedText}" Margin="0,0,0,4" />
                <StackPanel Spacing="3">
                  <TextBlock Text="📊 Git" FontSize="11" FontWeight="SemiBold" Foreground="#E89A3C" />
                  <CheckBox Content="commit（提交）" IsChecked="{Binding BlockGitCommit}" FontSize="12" Padding="4,2" Margin="8,0,0,0" />
                  <CheckBox Content="push（推送）" IsChecked="{Binding BlockGitPush}" FontSize="12" Padding="4,2" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="🐙 GitHub" FontSize="11" FontWeight="SemiBold" Foreground="#9B59B6" />
                  <CheckBox Content="pr_merge（合并PR）" IsChecked="{Binding BlockGhPrMerge}" FontSize="12" Padding="4,2" Margin="8,0,0,0" />
                  <CheckBox Content="pr_create（创建PR）" IsChecked="{Binding BlockGhPrCreate}" FontSize="12" Padding="4,2" Margin="8,0,0,0" />
                  <CheckBox Content="release_delete（删除release）" IsChecked="{Binding BlockGhReleaseDelete}" FontSize="12" Padding="4,2" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="📄 文件" FontSize="11" FontWeight="SemiBold" Foreground="#E74C3C" />
                  <CheckBox Content="delete（删文件）" IsChecked="{Binding BlockFileDelete}" FontSize="12" Padding="4,2" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="⚡ Shell" FontSize="11" FontWeight="SemiBold" Foreground="#3498DB" />
                  <CheckBox Content="bash/powershell（shell）" IsChecked="{Binding BlockShell}" FontSize="12" Padding="4,2" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="💾 磁盘根保护" FontSize="11" FontWeight="SemiBold" Foreground="#E74C3C" />
                  <TextBlock Text="勾选=禁止AI扫盘/删盘，取消=放行" FontSize="10" Foreground="{DynamicResource GuiMutedText}" Margin="8,0,0,0" />
                  <ItemsControl ItemsSource="{Binding ProtectedDrives}" Margin="8,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DriveProtectionItem">
                        <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsProtected}" FontSize="12" Padding="4,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </Popup>
        </Panel>
        <!-- 设置按钮 -->
        <Button Grid.Column="5" Classes="ghost" Padding="7,3" Content="⚙" FontSize="12"
                ToolTip.Tip="设置面板" Command="{Binding ToggleSettingsPanelCommand}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
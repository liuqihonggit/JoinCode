<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>JoinCode.Tui</RootNamespace>
    <AssemblyName>jcctui</AssemblyName>
    <Description>JoinCode TUI 终端界面（独立 exe，不走 CLI 管道）</Description>
    <NoWarn>$(NoWarn);JCC9001;CS8604;CS1573;CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用 JoinCode 复用 EngineSessionFactory + Abstractions 门面；TUI 不走 CLI 管道，用 CreateGuiSessionAsync 组装 DI -->
    <ProjectReference Include="$(RepoRoot)app/cli/JoinCode.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [EnumValue] 源码生成器 — TUI 枚举(ToolBarAction/FooterTab等)生成 XxxConstants -->
    <ProjectReference Include="$(RepoRoot)gen/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Terminal.Gui + EditorView 改用 NuGet 包引用（本地源码引用在文件夹重整理后路径失效） -->
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <PackageReference Include="Terminal.Gui.Editor" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Host.Tests" />
    <InternalsVisibleTo Include="JoinCode.Tui.Tests" />
  </ItemGroup>

</Project>

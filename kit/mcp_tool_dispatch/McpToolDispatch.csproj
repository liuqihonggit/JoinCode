<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>library</ProjectType>
  <RootNamespace>JoinCode.McpToolDispatch</RootNamespace>
    <AssemblyName>JoinCode.McpToolDispatch</AssemblyName>
    <PackageId>JoinCode.McpToolDispatch</PackageId>
    <Description>JoinCode McpToolDispatch 子系统 — MCP 工具调度、执行管道、权限检查</Description>
    <NoWarn>$(NoWarn);IL2026;IL3050;NU5104</NoWarn>
  </PropertyGroup>

  <!-- 强制 XML 文档注释完整:开启文档生成 + CS1591(缺少公开成员注释)升为错误 -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn.Replace('CS1591;', '').Replace(';CS1591', '').Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)lib/abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/guard/Guard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- McpToolDispatch.Generator 是必需的（工具调度注册源码生成器） -->
    <ProjectReference Include="$(RepoRoot)gen/mcp_tool_dispatch.generator/McpToolDispatch.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)gen/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.McpToolDispatch.Tests" />
    <InternalsVisibleTo Include="JoinCode.Composition" />
    <InternalsVisibleTo Include="JoinCode.Composition.Tests" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>library</ProjectType>
  <RootNamespace>JoinCode.Clock</RootNamespace>
    <AssemblyName>JoinCode.Clock</AssemblyName>
    <PackageId>JoinCode.Clock</PackageId>
    <Description>JoinCode ⏰ Clock 子系统 — 目标引擎、工作流宿主</Description>
  </PropertyGroup>

  <!-- 强制 XML 文档注释完整:开启文档生成 + CS1591(缺少公开成员注释)升为错误 -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn.Replace('CS1591;', '').Replace(';CS1591', '').Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)lib/abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)kit/composition/Composition.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/vault/Vault.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/scheduling/Scheduling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Core.Tests" />
    <InternalsVisibleTo Include="JoinCode.Core.Tests.Terminal" />
    <InternalsVisibleTo Include="JoinCode.Core.Tests.Permission" />
    <InternalsVisibleTo Include="JoinCode.Core.Tests.Services" />
    <InternalsVisibleTo Include="JoinCode.Dream.Tests" />
    <InternalsVisibleTo Include="JoinCode.Core.Tests.Agents" />
    <InternalsVisibleTo Include="JoinCode.Core.Tests.Context" />
    <InternalsVisibleTo Include="JoinCode.Clock.Tests" />
    <InternalsVisibleTo Include="JoinCode.Integration.Tests" />
  </ItemGroup>



  
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)gen/prompt_template.generator/PromptTemplate.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

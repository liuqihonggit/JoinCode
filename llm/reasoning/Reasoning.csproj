<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>library</ProjectType>
  <RootNamespace>JoinCode.Reasoning</RootNamespace>
    <AssemblyName>JoinCode.Reasoning</AssemblyName>
    <PackageId>JoinCode.Reasoning</PackageId>
    <Description>JoinCode Reasoning 子系统 — 结构化推理引擎、三权分立Agent、证据验证</Description>
    <NoWarn>$(NoWarn);IL2026;IL3050;NU5104</NoWarn>
    <!-- 强制 XML 文档注释完整：从继承的 NoWarn 中移除 CS1591，并升级为错误 -->
    <NoWarn>$(NoWarn.Replace(';CS1591', '').Replace('CS1591;', '').Replace('CS1591', ''))</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)lib/abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)llm/agents/Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)gen/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Reasoning.Tests" />
    <InternalsVisibleTo Include="JoinCode" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>library</ProjectType>
    <Description>JoinCode 抽象配置层 — WorkflowConfig/ModelCatalog/ActorSettings/Settings 校验，零 abs_core 依赖</Description>
    <AllowPack>true</AllowPack>
    <PackageId>JoinCode.Abstractions.Configuration</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/primitives/Abstractions.Primitives.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Primitives" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/exceptions/Abstractions.Exceptions.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Exceptions" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/generators/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Integration.Tests" />
    <InternalsVisibleTo Include="JoinCode.Abs.Core.Tests" />
    <InternalsVisibleTo Include="JoinCode.Abs.Ai.Tests" />
    <InternalsVisibleTo Include="JoinCode.Abs.Guard.Tests" />
    <InternalsVisibleTo Include="JoinCode.Abs.Hands.Tests" />
    <InternalsVisibleTo Include="JoinCode.Plugins.Tests" />
    <InternalsVisibleTo Include="JoinCode.Plugins.Infrastructure" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>library</ProjectType>
    <Description>JoinCode 抽象工具 Schema + CLI 节点契约与 YAML 基础工具清单</Description>
    <ExcludeStructura>true</ExcludeStructura>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowPack>true</AllowPack>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="$(YamlDotNetVersion)" />
    <EmbeddedResource Include="$(RepoRoot)resources/tools/base.yaml" LogicalName="JoinCode.CliNodes.base.yaml" />
    <EmbeddedResource Include="$(RepoRoot)resources/tools/cli_groups.yaml" LogicalName="JoinCode.CliNodes.cli_groups.yaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- 帮助文本解析与近似名建议是 internal 实现细节，但要由单测锁住行为。 -->
    <InternalsVisibleTo Include="JoinCode.CliNodes.Tests" />
  </ItemGroup>

</Project>

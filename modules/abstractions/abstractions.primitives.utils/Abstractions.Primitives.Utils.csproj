<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>library</ProjectType>
    <Description>JoinCode 抽象工具/常量/枚举 — AgentToolName/ToolCategory/ExitCode/ChatCommandName 等</Description>
    <ExcludeStructura>true</ExcludeStructura>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowPack>true</AllowPack>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/generators/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions.primitives.shared/Abstractions.Primitives.Shared.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Primitives.Shared" Version="$(JccComponentPackageVersion)" />
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions.primitives.configuration/Abstractions.Primitives.Configuration.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Primitives.Configuration" Version="$(JccComponentPackageVersion)" />
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions.primitives.tools/Abstractions.Primitives.Tools.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Primitives.Tools" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>

</Project>

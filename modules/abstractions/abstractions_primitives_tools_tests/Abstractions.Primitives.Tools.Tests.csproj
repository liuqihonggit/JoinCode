<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>test</ProjectType>
    <RootNamespace>CliNodes.Tests</RootNamespace>
    <AssemblyName>JoinCode.CliNodes.Tests</AssemblyName>
    <Description>CLI 节点契约层单元测试 — ADR 0157 v2（基础工具 YAML 注册 / -h 自描述 / CLI 搜索下钻）</Description>
    <NoWarn>$(NoWarn);JCC3007;JCC3010;JCC3011;JCC3012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/abstractions/abstractions_primitives_tools/Abstractions.Primitives.Tools.csproj" />
    <!-- 审计落盘断言读文件必须走 IFileSystem（JCC9001），由工厂按环境选择实现。 -->
    <ProjectReference Include="$(RepoRoot)modules/abstractions/infrastructure/Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)resources/tools/policies/file.yaml" LogicalName="CliNodes.Tests.policy.file.yaml" />
    <!-- 全量策略源都过一遍严格解析：单个 exe 只在自己被调用时才加载策略，CI 不会自然覆盖 github 这类不常跑的组。 -->
    <EmbeddedResource Include="$(RepoRoot)resources/tools/policies/*.yaml" LogicalName="CliNodes.Tests.allpolicies.%(Filename).policy.yaml" />
    <EmbeddedResource Include="$(RepoRoot)modules/tools/cli_nodes/groups/file/node.yaml" LogicalName="CliNodes.Tests.node.file.yaml" />
    <EmbeddedResource Include="test_auth_policy.yaml" LogicalName="CliNodes.Tests.policy.auth.yaml" />
  </ItemGroup>

</Project>

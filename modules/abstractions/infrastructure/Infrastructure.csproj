<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>library</ProjectType>
  <AllowPack>true</AllowPack>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 强制 XML 文档注释完整:开启文档生成 + CS1591(缺少公开成员注释)升为错误 -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn.Replace('CS1591;', '').Replace(';CS1591', '').Replace('CS1591', ''))</NoWarn>
    <!-- 中央登记（JCC9312）: 本地化引导必须随 Infrastructure 程序集加载自动执行（L.T 懒初始化），
         放到上层可执行程序集只有 CLI 宿主生效、其余宿主退化为返回 key（CI storage/cognition 失败实证）。
         仅此一处；新增 ModuleInitializer 必须在各自 csproj 同样显式登记并写明理由。 -->
    <JccAllowModuleInitializer>true</JccAllowModuleInitializer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/async_lock/AsyncLock.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.AsyncLock" Version="$(JccComponentPackageVersion)" />

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>library</ProjectType>
    <Description>JoinCode 抽象原语层 — 纯 BCL 包装（时钟/字典/执行上下文/HTTP/Shell 接口），零 JoinCode.Abstractions 依赖</Description>
    <ExcludeStructura>true</ExcludeStructura>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowPack>true</AllowPack>
  </PropertyGroup>

</Project>

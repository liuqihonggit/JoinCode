<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>app</ProjectType>
  <OutputType>Exe</OutputType>
    <RootNamespace>JoinCode</RootNamespace>
    <AssemblyName>jcc</AssemblyName>
    <Description>JoinCode 命令行工具</Description>
    <NoWarn>$(NoWarn);JCC9001;CS8604;CS1573;CS1587</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/apps/engine/JoinCode.Engine.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/composition/composition/Composition.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/storage/clock/Clock.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/services/dream/Dream.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/services/browser/Browser.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/composition/pipelines/Pipelines.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/persistence/pithosdb/PithosDB.Core.csproj" />
    <!-- ADR 0149: jcc 默认 TUI 宿主,引用 NativeTui.Host(Library) 调 RunInteractiveAsync -->
    <ProjectReference Include="$(RepoRoot)native_tui/apps/NativeTui.Host/NativeTui.Host.csproj" />
</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/generators/mcp_tool_dispatch.generator/McpToolDispatch.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)modules/generators/aot_handler.generator/AotHandler.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)modules/generators/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)modules/generators/cli_option.generator/CliOption.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)modules/generators/app_module.generator/AppModule.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Dream.Tests" />
    <InternalsVisibleTo Include="JoinCode.Clock.Tests" />
    <InternalsVisibleTo Include="JoinCode.Composition.Tests" />
    <InternalsVisibleTo Include="JoinCode.Host.Tests" />
    <InternalsVisibleTo Include="JoinCode.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <!-- === 原生 DLL 嵌入资源（Release/AOT 模式） === -->
  <!-- NativeAOT 无法静态链接 C/C++ 原生库，嵌入为 EmbeddedResource，运行时由 NativeDllBootstrapper 释放 -->
  <!-- tree-sitter 只嵌入实际用到的语法：全量 30 个语法共 68 MB，其中 28 个从未被加载（61.7 MB 死重）。
       生产代码里 new Language(...) 的全部调用点只有两处：
         · c-sharp —— CodeIndex 解析 *.cs（CodeIndexer 只扫 .cs/.md，见 CollectCsFilesRecursive）
         · bash    —— guard.security 的 BashAstSecurityWalker（FAIL-CLOSED 命令检查）
       TreeSitter.DotNet 按 "tree-sitter-" + languageId 拼名加载，不枚举目录，因此删掉其余语法不影响任何调用点。
       新增语言时必须同时改这里和 Debug 输出裁剪目标（TrimUnusedTreeSitterGrammars）。 -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <EmbeddedResource Include="$(NuGetPackageRoot)\skiasharp.nativeassets.win32\4.151.1\runtimes\win-x64\native\libSkiaSharp.dll" LogicalName="JoinCode.NativeDlls.libSkiaSharp.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)\docnet.core\$(DocnetCoreVersion)\runtimes\win-x64\native\pdfium.dll" LogicalName="JoinCode.NativeDlls.pdfium.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)\treesitter.dotnet\1.3.0\runtimes\win-x64\native\tree-sitter.dll" LogicalName="JoinCode.NativeDlls.tree-sitter.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)\treesitter.dotnet\1.3.0\runtimes\win-x64\native\tree-sitter-c-sharp.dll" LogicalName="JoinCode.NativeDlls.tree-sitter-c-sharp.dll" />
    <EmbeddedResource Include="$(NuGetPackageRoot)\treesitter.dotnet\1.3.0\runtimes\win-x64\native\tree-sitter-bash.dll" LogicalName="JoinCode.NativeDlls.tree-sitter-bash.dll" />
  </ItemGroup>

  <!-- Debug/非嵌入模式下语法 DLL 直接躺在输出目录，同样只需要两个；其余 28 个删掉省 61.7 MB。
       NuGet 每次都按 PreserveNewest 重新拷贝，所以目标必须挂在每次 Build 之后执行。 -->
  <Target Name="TrimUnusedTreeSitterGrammars" AfterTargets="Build" Condition="'$(Configuration)' != 'Release'">
    <ItemGroup>
      <UnusedTreeSitterGrammar Include="$(TargetDir)tree-sitter-*.dll"
                               Exclude="$(TargetDir)tree-sitter-c-sharp.dll;$(TargetDir)tree-sitter-bash.dll" />
    </ItemGroup>
    <Delete Files="@(UnusedTreeSitterGrammar)" Condition="'@(UnusedTreeSitterGrammar)' != ''" />
  </Target>

  <!-- publish 后清理原生 DLL — 已嵌入资源，无需外部 DLL -->
  <Target Name="RemoveNativeDllsFromPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <NativeDllInPublish Include="$(PublishDir)\libSkiaSharp.dll" />
      <NativeDllInPublish Include="$(PublishDir)\libSkiaSharp.pdb" />
      <NativeDllInPublish Include="$(PublishDir)\pdfium.dll" />
      <NativeDllInPublish Include="$(PublishDir)\tree-sitter*.dll" />
    </ItemGroup>
    <Delete Files="@(NativeDllInPublish)" />
    <Message Importance="High" Text="Removed @(NativeDllInPublish->Count()) native DLLs from publish dir (embedded in exe)" />
  </Target>

    <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/composition/Abstractions.Composition.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Composition" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/brain/Abstractions.Brain.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Brain" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/memory/Abstractions.Memory.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Memory" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions.configuration/Abstractions.Configuration.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Configuration" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>
</Project>

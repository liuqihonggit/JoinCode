<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>app</ProjectType>
    <RootNamespace>JoinCode</RootNamespace>
    <AssemblyName>JoinCode.Engine</AssemblyName>
    <Description>JoinCode 引擎库 — 会话/回合驱动/协议层（ADR 0143：GUI/TUI/CLI 多宿主共享，协议层唯一数据源）</Description>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);JCC9001;CS8604;CS1573;CS1587</NoWarn>
  </PropertyGroup>

  <!-- 引用面与 cli 宿主相同（引擎组件传递闭包横跨 composition/slash/brain/agents） -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/composition/composition/Composition.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/storage/clock/Clock.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/services/dream/Dream.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/services/browser/Browser.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/composition/pipelines/Pipelines.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/persistence/pithosdb/PithosDB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Host.Tests" />
    <InternalsVisibleTo Include="JoinCode.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

</Project>

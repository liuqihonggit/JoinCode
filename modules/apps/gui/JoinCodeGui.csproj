<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>ui</ProjectType>
  <OutputType>WinExe</OutputType>
    <RootNamespace>JoinCode.Gui</RootNamespace>
    <AssemblyName>JoinCode.Gui</AssemblyName>
    <Description>JoinCode Ava GUI</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);JCC9001;JCC10001;JCC10002;CS8604;CS1573;CS1587;NU1903;CS0618</NoWarn>
    <!-- WebView2 生产接入四件套（ADR 0138，spike 实测 TASK054）：
         1) windows TFM（CsWinRT 投影消费 net8.0 分支，TPV 与本机 UAP SDK 对齐）
         2) 投影开关（托管 COM 互操作在 NativeAOT 运行时不可用）
         3) x64 显式（包 targets 对 AnyCPU 误判 x86 → 组件架构错配 BadImageFormatException）
         4) app.manifest（supportedOS + 免注册 WinRT activatableClass 条目） -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2Version)" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(CsWinRTVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebUI 静态资源（B2 路线，ADR 0138）：随 exe 分发，file:// 离线加载 -->
    <Content Include="webui\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="assets\**" Exclude="assets\*.xshd" />
    <EmbeddedResource Include="assets\ChatHighlighting.xshd" />
    <EmbeddedResource Include="theming\Appearance.json" LogicalName="JoinCode.Gui.Appearance.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
    <PackageReference Include="Markdig" Version="$(MarkdigVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\Dock\src\Dock.Avalonia\Dock.Avalonia.csproj" />
    <ProjectReference Include="..\..\..\libs\Dock\src\Dock.Avalonia.Themes.Fluent\Dock.Avalonia.Themes.Fluent.csproj" />
    <ProjectReference Include="..\..\..\libs\Dock\src\Dock.Model\Dock.Model.csproj" />
    <ProjectReference Include="..\..\..\libs\Dock\src\Dock.Model.Mvvm\Dock.Model.Mvvm.csproj" />
    <ProjectReference Include="..\..\..\libs\Dock\src\Dock.Serializer.SystemTextJson\Dock.Serializer.SystemTextJson.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 解耦边界：Views/ViewModels 只依赖 Abstractions 门面接口与 DTO，不引 Core.Brain/Hands 实现
         引擎组装收敛在 Hosting/ 触碰处（ADR 0143 Step 4 切直引 engine，消除 cli 依赖） -->
    <ProjectReference Include="$(RepoRoot)modules/apps/engine/JoinCode.Engine.csproj" />
    <!-- Hosting 层（JccChatSession）读取 teammate 子会话列表，需直接引用 Scheduling -->
    <ProjectReference Include="$(RepoRoot)modules/storage/scheduling/Scheduling.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/async_primitives/bcl_bridge/BclBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Gui.Tests" />
  </ItemGroup>

  <!-- R2R 发布时排除 Abstractions（直接+传递引用导致 SDK 重复项 bug MSB4094，门面程序集保持 JIT） -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Abstractions.dll" />
  </ItemGroup>

  <!-- 修复: AppendRuntimeIdentifierToOutputPath=false + 全局 RID 导致 ResolvedFileToPublish 出现同一路径重复项，
        crossgen2 报 "Multiple input files matching same simple name"。发布前按路径去重。 -->
  <Target Name="DeduplicateResolvedFilesForR2R" BeforeTargets="_PrepareForReadyToRunCompilation" Condition="'$(PublishReadyToRun)' == 'true'">
    <ItemGroup>
      <_ResolvedFileDedup Remove="@(_ResolvedFileDedup)" />
      <_ResolvedFileDedup Include="@(ResolvedFileToPublish->Distinct())" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(_ResolvedFileDedup)" />
    </ItemGroup>
  </Target>

</Project>

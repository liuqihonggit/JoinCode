<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             xmlns:vm="using:JoinCode.Gui.ViewModels"
             x:Class="JoinCode.Gui.Views.PanelView"
             x:Name="PanelViewRoot"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleButton.panelTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ToggleButton.panelTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource GuiButtonHover}" />
    </Style>
    <Style Selector="ToggleButton.panelTab:checked">
      <Setter Property="Foreground" Value="{DynamicResource GuiAccentText}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource GuiSearchBarBackground}"
          BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,1,0,0"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="{DynamicResource GuiTopBarBackground}"
              BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,0,0,1"
              x:Name="PanelHeaderBar"
              PointerPressed="OnHeaderPointerPressed"
              PointerMoved="OnHeaderPointerMoved"
              PointerReleased="OnHeaderPointerReleased">
        <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
          <ToggleButton Classes="panelTab" Content="输出"
                        Command="{Binding SwitchPanelTabCommand}" CommandParameter="Output"
                        IsChecked="{Binding IsPanelTabOutput, Mode=OneWay}" />
          <ToggleButton Classes="panelTab" Content="日志"
                        Command="{Binding SwitchPanelTabCommand}" CommandParameter="Log"
                        IsChecked="{Binding IsPanelTabLog, Mode=OneWay}" />
          <ToggleButton Classes="panelTab" Content="终端"
                        Command="{Binding SwitchPanelTabCommand}" CommandParameter="Terminal"
                        IsChecked="{Binding IsPanelTabTerminal, Mode=OneWay}" />
          <ToggleButton Classes="panelTab" Content="问题"
                        Command="{Binding SwitchPanelTabCommand}" CommandParameter="Problems"
                        IsChecked="{Binding IsPanelTabProblems, Mode=OneWay}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="▾" FontSize="14" Padding="6,3"
                Command="{Binding TogglePanelCommand}" ToolTip.Tip="折叠面板" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" Margin="0,0,28,0" HorizontalAlignment="Right">
          <Button Classes="ghost" Content="⤒" FontSize="10" Padding="4,2" MinHeight="0"
                  Command="{Binding SetPanelPositionCommand}"
                  CommandParameter="{x:Static vm:PanelPosition.Top}" ToolTip.Tip="面板→顶部" />
          <Button Classes="ghost" Content="⤓" FontSize="10" Padding="4,2" MinHeight="0"
                  Command="{Binding SetPanelPositionCommand}"
                  CommandParameter="{x:Static vm:PanelPosition.Bottom}" ToolTip.Tip="面板→底部" />
          <Button Classes="ghost" Content="⇤" FontSize="10" Padding="4,2" MinHeight="0"
                  Command="{Binding SetPanelPositionCommand}"
                  CommandParameter="{x:Static vm:PanelPosition.Left}" ToolTip.Tip="面板→左侧" />
          <Button Classes="ghost" Content="⇥" FontSize="10" Padding="4,2" MinHeight="0"
                  Command="{Binding SetPanelPositionCommand}"
                  CommandParameter="{x:Static vm:PanelPosition.Right}" ToolTip.Tip="面板→右侧" />
        </StackPanel>
        </Grid>
      </Border>
      <Panel Grid.Row="1" ClipToBounds="True">
        <ScrollViewer IsVisible="{Binding IsPanelTabOutput}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <SelectableTextBlock Text="{Binding PanelOutputText}" FontSize="12"
                                FontFamily="{DynamicResource GuiMonoFont}"
                                Foreground="{DynamicResource GuiSecondaryText}"
                                TextWrapping="NoWrap" Margin="8,4" />
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsPanelTabLog}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <TextBox Text="{Binding StatusLogText, Mode=OneWay}" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   FontSize="{Binding StatusLogFontSize}"
                   FontFamily="{DynamicResource GuiMonoFont}"
                   Foreground="{DynamicResource GuiMutedText}"
                   Margin="4" BorderThickness="0" Background="Transparent" />
        </ScrollViewer>
        <Grid IsVisible="{Binding IsPanelTabTerminal}" RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBox Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="{DynamicResource GuiMonoFont}" FontSize="12"
                     Foreground="{DynamicResource GuiSecondaryText}"
                     Margin="4" BorderThickness="0" Background="Transparent" />
          </ScrollViewer>
          <Border Grid.Row="1" Background="{DynamicResource GuiTopBarBackground}"
                  BorderBrush="{DynamicResource GuiDivider}" BorderThickness="0,1,0,0" Padding="4,3">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="{Binding TerminalPrompt}"
                         FontFamily="{DynamicResource GuiMonoFont}" FontSize="12"
                         Foreground="{DynamicResource GuiAccentText}" Margin="2,0" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding TerminalInput}" PlaceholderText="输入命令，Enter 执行…"
                       FontFamily="{DynamicResource GuiMonoFont}" FontSize="12"
                       BorderThickness="0" Padding="2" Background="Transparent"
                       KeyDown="OnTerminalKeyDown" />
            </Grid>
          </Border>
        </Grid>
        <Grid IsVisible="{Binding IsPanelTabProblems}" RowDefinitions="Auto,*">
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="8,4">
            <Button Classes="ghost" Content="扫描" Command="{Binding ScanProblemsCommand}" FontSize="12" Padding="8,2" MinHeight="0" />
            <Button Classes="ghost" Content="清空" Command="{Binding ClearProblemsCommand}" FontSize="12" Padding="8,2" MinHeight="0" />
            <TextBlock Text="{Binding ProblemErrorCount}" Foreground="{DynamicResource GuiSecondaryText}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="错误" Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ProblemWarningCount}" Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Text="警告" Foreground="{DynamicResource GuiMutedText}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding PanelProblems}" Margin="8,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayText}" FontSize="12"
                             FontFamily="{DynamicResource GuiMonoFont}"
                             Foreground="{DynamicResource GuiSecondaryText}"
                             Margin="0,1" TextWrapping="NoWrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Panel>
    </Grid>
  </Border>
</UserControl>

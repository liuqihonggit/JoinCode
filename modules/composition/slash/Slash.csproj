<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>library</ProjectType>
  <RootNamespace>JoinCode.ChatCommands</RootNamespace>
    <AssemblyName>JoinCode.Slash</AssemblyName>
    <PackageId>JoinCode.Slash</PackageId>
    <Description>JoinCode 斜杠命令子系统 — 所有 /xxx 命令的实现与注册</Description>
    <NoWarn>$(NoWarn);IL2026;IL3050;IL2066;IL2075;NU5104</NoWarn>
  </PropertyGroup>

  <!-- 强制 XML 文档注释完整:开启文档生成 + CS1591(缺少公开成员注释)升为错误 -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn.Replace('CS1591;', '').Replace(';CS1591', '').Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/abstractions/infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/services/bridge/Bridge.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/mcp/mcp/Mcp.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/cognition/brain/Brain.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/guard/guard/Guard.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/cognition/hands/Hands.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/perception/eyes/Eyes.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/perception/vision/Vision.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/storage/vault/Vault.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/storage/scheduling/Scheduling.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/mcp/mcp_tool_dispatch/McpToolDispatch.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/llm/agents/Agents.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/async_primitives/transport.impl/Transport.Impl.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/llm/reasoning/Reasoning.csproj" /></ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/generators/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)modules/generators/mcp_tool_dispatch.generator/McpToolDispatch.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Composition" />
    <InternalsVisibleTo Include="JoinCode.Composition.Tests" />
    <InternalsVisibleTo Include="JoinCode.Host.Tests" />
    <InternalsVisibleTo Include="JoinCode.Integration.Tests" />
  </ItemGroup>

</Project>

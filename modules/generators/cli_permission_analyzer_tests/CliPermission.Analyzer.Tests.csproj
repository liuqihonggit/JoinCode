<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>test</ProjectType>
    <RootNamespace>CliPermission.Analyzer.Tests</RootNamespace>
    <AssemblyName>JoinCode.CliPermission.Analyzer.Tests</AssemblyName>
    <Description>CLI 参数权限分析器测试 — ADR 0168 有参无权/有权无参双向对账</Description>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/generators/cli_permission_analyzer/CliPermission.Analyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="xunit" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>

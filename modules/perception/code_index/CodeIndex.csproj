<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>library</ProjectType>
  <RootNamespace>JoinCode.CodeIndex</RootNamespace>
    <AssemblyName>CodeIndex</AssemblyName>
    <PackageId>JoinCode.CodeIndex</PackageId>
    <AllowPack>true</AllowPack>
    <NoWarn>$(NoWarn);NU5100;JCC9104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/async_lock/AsyncLock.csproj" />
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions/Abstractions.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions" Version="$(JccComponentPackageVersion)" />
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/infrastructure/Infrastructure.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Infrastructure" Version="$(JccComponentPackageVersion)" />
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/collections/structura/Structura.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/tools/onnx_embedding/OnnxEmbeddingExe.csproj" />
    <!-- CSharpLanguagePlugin 直接实现插件契约，显式声明，禁止依赖 Infrastructure 的传递引用 -->
    <ProjectReference Include="$(RepoRoot)modules/plugins/plugins.contracts/Plugins.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>JoinCode.Eyes.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>JoinCode.CodeIndex.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>



  
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/memory/Abstractions.Memory.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Memory" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>
  <PropertyGroup>
    <JccApiVisibility>public</JccApiVisibility>
  </PropertyGroup>

  <!-- 显式声明下载器依赖（禁止依赖 Infrastructure 的传递引用） -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/storage/downloader/Downloader.csproj" />
  </ItemGroup>

</Project>

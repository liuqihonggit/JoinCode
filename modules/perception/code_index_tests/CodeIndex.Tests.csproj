<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>test</ProjectType>
  <RootNamespace>CodeIndex.Tests</RootNamespace>
    <AssemblyName>JoinCode.CodeIndex.Tests</AssemblyName>
    <Description>CodeIndex 组件单元测试</Description>
    <NoWarn>$(NoWarn);JCC3007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/perception/code_index/CodeIndex.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/abstractions/abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/abstractions/infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/persistence/kv_store/KvStore.csproj" />
    <ProjectReference Include="$(RepoRoot)test/unit/testing.common/Testing.Common.csproj" /></ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/memory/Abstractions.Memory.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Memory" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>

  <!-- 显式声明下载器依赖（禁止依赖 Infrastructure 的传递引用） -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/storage/downloader/Downloader.csproj" />
  </ItemGroup>

</Project>

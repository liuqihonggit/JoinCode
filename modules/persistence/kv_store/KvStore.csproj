<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>library</ProjectType>
    <AssemblyName>JoinCode.Persistence.KvStore</AssemblyName>
    <PackageId>JoinCode.Persistence.KvStore</PackageId>
    <Description>PithosDB KV 存储适配层 — IKvStore 实现、租约与 DI 注册</Description>
    <ExcludeStructura>true</ExcludeStructura>
    <AllowPack>true</AllowPack>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn.Replace('CS1591;', '').Replace(';CS1591', '').Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions_primitives_interfaces/Abstractions.Primitives.Interfaces.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Primitives.Interfaces" Version="$(JccComponentPackageVersion)" />
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions_utils/Abstractions.Utils.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Utils" Version="$(JccComponentPackageVersion)" />
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/infrastructure/Infrastructure.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Infrastructure" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/persistence/pithosdb/PithosDB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDependencyInjectionVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 被 composition/apps/perception/tools 等跨域直接引用（IKvStore 适配器），按 API 准入门暴露 -->
    <JccApiVisibility>public</JccApiVisibility>
  </PropertyGroup>

</Project>

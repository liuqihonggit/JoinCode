<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>library</ProjectType>
    <RootNamespace>Infrastructure.Network.Downloader</RootNamespace>
    <AssemblyName>Downloader</AssemblyName>
    <PackageId>JoinCode.Downloader</PackageId>
    <AllowPack>true</AllowPack>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Downloader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions/Abstractions.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/generators/enum_metadata_generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)modules/generators/fsm_generator/Fsm.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <JccApiVisibility>public</JccApiVisibility>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../cli_node.props" />

  <PropertyGroup>
    <AssemblyName>jcc-tool-git</AssemblyName>
    <RootNamespace>JoinCode.CliNode.Git</RootNamespace>
    <Description>git 工具分组独立 CLI.exe — 说明复用现有 [McpTool] 特性，零引擎依赖</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="help.txt" LogicalName="JoinCode.CliNodes.Groups.git.help.txt" />
    <EmbeddedResource Include="$(RepoRoot)resources/tools/policies/git.yaml" LogicalName="JoinCode.CliNodes.Groups.git.policy.yaml" />
    <AdditionalFiles Include="$(RepoRoot)resources/tools/policies/git.yaml" />
    <ProjectReference Include="$(RepoRoot)modules/generators/cli_permission_analyzer/CliPermission.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

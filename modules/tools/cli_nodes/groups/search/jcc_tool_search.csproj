<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../cli_node.props" />

  <PropertyGroup>
    <AssemblyName>jcc-tool-search</AssemblyName>
    <RootNamespace>JoinCode.CliNode.Search</RootNamespace>
    <Description>search 工具分组独立 CLI.exe — -h 复用现有 MCP 特性说明</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="help.txt" LogicalName="JoinCode.CliNodes.Groups.search.help.txt" />
    <EmbeddedResource Include="$(RepoRoot)resources/tools/policies/search.yaml" LogicalName="JoinCode.CliNodes.Groups.search.policy.yaml" />
    <AdditionalFiles Include="$(RepoRoot)resources/tools/policies/search.yaml" />
    <ProjectReference Include="$(RepoRoot)modules/generators/cli_permission_analyzer/CliPermission.Analyzer.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

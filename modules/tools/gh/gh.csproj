<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>tool</ProjectType>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>jcc-gh</AssemblyName>
    <RootNamespace>JoinCode.Gh</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Gh.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/abstractions/infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/persistence/kv_store/KvStore.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/storage/downloader/Downloader.csproj" />
    <!-- GitHub REST API 客户端实现在 tools/github_client 库（原 abstractions/infrastructure） -->
    <ProjectReference Include="$(RepoRoot)modules/tools/github_client/GitHubClient.csproj" />
  </ItemGroup>

  <!-- delegate 自身自证：直跑 jcc-gh 必须受同一份 github 策略约束（ADR 0168）。 -->
  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions_primitives_tools/Abstractions.Primitives.Tools.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Primitives.Tools" Version="$(JccComponentPackageVersion)" />
    <EmbeddedResource Include="$(RepoRoot)resources/tools/policies/github.yaml" LogicalName="JoinCode.CliNodes.Groups.github.policy.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NaCl.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/generators/enum_metadata_generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/memory/Abstractions.Memory.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Memory" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UsePackedComponents)' != 'true'" Include="$(RepoRoot)modules/abstractions/abstractions_configuration/Abstractions.Configuration.csproj" />
    <PackageReference Condition="'$(UsePackedComponents)' == 'true'" Include="JoinCode.Abstractions.Configuration" Version="$(JccComponentPackageVersion)" />
  </ItemGroup>
</Project>

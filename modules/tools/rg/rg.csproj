<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>tool</ProjectType>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>jcc-rg</AssemblyName>
    <RootNamespace>JoinCode.Rg</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Rg.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)modules/abstractions/abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/abstractions/hands/Abstractions.Hands.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/abstractions/infrastructure/Infrastructure.csproj" />
  </ItemGroup>

</Project>

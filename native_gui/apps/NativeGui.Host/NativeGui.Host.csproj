<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>ui</ProjectType>
  <OutputType>WinExe</OutputType>
    <RootNamespace>JoinCode.Gui</RootNamespace>
    <AssemblyName>NativeGui.Host</AssemblyName>
    <Description>NativeGui 宿主 — WebView2 + Avalonia 表现层 + JccChatSession 引擎装配（ADR 0145；协议核心在 NativeGui.Core）</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);JCC9001;JCC10001;JCC10002;CS8604;CS1573;CS1587;NU1903;CS0618</NoWarn>
    <!-- WebView2 生产接入四件套（ADR 0138，spike 实测 TASK054）：
         1) windows TFM（CsWinRT 投影消费 net8.0 分支，TPV 与本机 UAP SDK 对齐）
         2) 投影开关（托管 COM 互操作在 NativeAOT 运行时不可用）
         3) x64 显式（包 targets 对 AnyCPU 误判 x86 → 组件架构错配 BadImageFormatException）
         4) app.manifest（supportedOS + 免注册 WinRT activatableClass 条目） -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="$(WebView2Version)" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="$(CsWinRTVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- WebUI 静态资源（B2 路线，ADR 0138）：随 exe 分发，file:// 离线加载（自研 UI，webui-smoke 对照用） -->
    <Content Include="webui\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引擎装配（ADR 0143 Step 4 直引 engine）+ 协议核心（ADR 0145） -->
    <ProjectReference Include="$(RepoRoot)native_gui/src/NativeGui.Core/NativeGui.Core.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/apps/engine/JoinCode.Engine.csproj" />
    <!-- Hosting 层（JccChatSession）读取 teammate 子会话列表，需直接引用 Scheduling -->
    <ProjectReference Include="$(RepoRoot)modules/storage/scheduling/Scheduling.csproj" />
    <ProjectReference Include="$(RepoRoot)modules/async_primitives/bcl_bridge/BclBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 枚举 [EnumValue] 元数据生成（GuiThemeVariant 等扩展；Core 内生成物 internal 不可跨程序集，Host 独立生成一份） -->
    <ProjectReference Include="$(RepoRoot)modules/generators/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JoinCode.Gui.Tests" />
  </ItemGroup>

  <!-- R2R 发布时排除 Abstractions（直接+传递引用导致 SDK 重复项 bug MSB4094，门面程序集保持 JIT） -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Abstractions.dll" />
  </ItemGroup>

  <!-- 修复: AppendRuntimeIdentifierToOutputPath=false + 全局 RID 导致 ResolvedFileToPublish 出现同一路径重复项，
        crossgen2 报 "Multiple input files matching same simple name"。发布前按路径去重。 -->
  <Target Name="DeduplicateResolvedFilesForR2R" BeforeTargets="_PrepareForReadyToRunCompilation" Condition="'$(PublishReadyToRun)' == 'true'">
    <ItemGroup>
      <_ResolvedFileDedup Remove="@(_ResolvedFileDedup)" />
      <_ResolvedFileDedup Include="@(ResolvedFileToPublish->Distinct())" />
    </ItemGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(_ResolvedFileDedup)" />
    </ItemGroup>
  </Target>

</Project>

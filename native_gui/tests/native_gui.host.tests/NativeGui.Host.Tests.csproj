<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>test</ProjectType>
  <RootNamespace>JoinCode.Gui.Tests</RootNamespace>
    <AssemblyName>NativeGui.Host.Tests</AssemblyName>
    <!-- xunit.v3 MTP 模式要求可执行测试项目（原 test/ 层级由 Test.Sdk 隐式满足，native_gui 层显式声明） -->
    <OutputType>Exe</OutputType>
    <!-- 与 NativeGui.Host 平台化 TFM 对齐（WebView2 投影要求，ADR 0138 四件套之一） -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- MSB3277: WebView2 包 buildTransitive 传递 Wpf.dll 引用与 windows TFM facade 版本冲突提示，测试不消费 WPF 面 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <NoWarn>$(NoWarn);NU1903;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主表现层（ADR 0145：windows TFM）+ 协议核心（internal 类型经 IVT 可见） -->
    <ProjectReference Include="$(RepoRoot)native_gui/apps/NativeGui.Host/NativeGui.Host.csproj" />
    <ProjectReference Include="$(RepoRoot)native_gui/src/NativeGui.Core/NativeGui.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Remove="xunit" />
    <PackageReference Remove="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
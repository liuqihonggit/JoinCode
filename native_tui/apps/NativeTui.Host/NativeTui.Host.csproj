<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NativeTui.Host</RootNamespace>
    <AssemblyName>NativeTui.Host</AssemblyName>
    <Description>NativeTui 宿主 — 进程内直连 jcc 引擎（ADR 0143 阶段二：IEventConsumer 事件直喂 ReplView，零协议税）</Description>
    <AllowPack>false</AllowPack>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NativeTui.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0140：NativeTui.Core 保持零依赖；引擎组装全在本宿主层 -->
    <ProjectReference Include="..\..\src\NativeTui.Core\NativeTui.Core.csproj" />
    <!-- M7-4：Markdown 投影卫星层（Markdig 隔离在此，Core 零依赖不变） -->
    <ProjectReference Include="..\..\src\NativeTui.Markdown\NativeTui.Markdown.csproj" />
    <!-- ADR 0143：跨 slnx 直引引擎库（照抄 gui 先例），不走 bridge_serve 子进程协议 -->
    <ProjectReference Include="..\..\..\modules\apps\engine\JoinCode.Engine.csproj" />
  </ItemGroup>

</Project>

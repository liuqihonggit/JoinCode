<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <ProjectType>tool</ProjectType>
  <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <PublishAot>false</PublishAot>
    <AssemblyName>jcc-audit</AssemblyName>
    <RootNamespace>JccAuditCli</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 分析器加载器使用反射，抑制 trim 警告和反射 API 规则 -->
    <NoWarn>$(NoWarn);IL2026;IL2072;IL2075;JCC9001;JCC9002;JCC1007;JCC1013;JCC1014;JCC1015;JCC1016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)lib/structura/Structura.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/infrastructure/Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)gen/aot_safety.shared/AotSafety.Shared.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(MicrosoftCodeAnalysisVersion)" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JccAuditCli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>

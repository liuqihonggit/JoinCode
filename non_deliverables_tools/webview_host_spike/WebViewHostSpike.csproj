<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>tool</ProjectType>
    <OutputType>Exe</OutputType>
    <RootNamespace>WebViewHostSpike</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WebView2 包 targets 对 AnyCPU 判定 EffectivePlatform=x86，会拷贝 win-x86 原生组件
         导致 x64 进程激活 BadImageFormatException；显式 x64 与 RuntimeIdentifier 对齐 -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- WebView2 托管 COM 互操作（lib_manual/netcoreapp3.0）在 NativeAOT 下 Runtime 抛
         NotSupportedException(ComWrappers.ComInterfaceForObject)；AOT 官方路线是 CsWinRT 投影：
         需 windows TFM（消费 net8.0 投影分支）+ WebView2EnableCsWinRTProjection + CsWinRT 运行时 -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
    <!-- WebView2 SDK 依赖内置 COM interop 支持开关 -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 非交付品探针工程：豁免 JCC 产品规范分析器（IFileSystem 注入/XML 注释等），
         保留 IsAotCompatible 与 ILC 真实 AOT 分析（spike 的核心证据） -->
    <JccAnalyzers>false</JccAnalyzers>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- WebView2 包 targets 无条件引用其 WPF 组件（WindowsBase 5.0 vs 10.0 ref 冲突），仅 CS 层使用 Core API，降噪 -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- spike 验证项：WebView2 SDK 自带 trim 警告（IL2104/IL3000/IL3002，单文件回退分支），
         提升为错误会阻断 ILC；降级为警告，运行期是否可用由 AOT 冒烟实证 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>

</Project>

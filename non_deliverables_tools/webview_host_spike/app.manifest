<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WebViewHostSpike"/>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- NativeControlHost 创建原生子窗口要求清单声明 supportedOS（Win10+） -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- 免注册 WinRT（Registration-free WinRT，Win10 1903+）：激活随应用分发的
       WebView2 WinRT 组件（native_uap/Microsoft.Web.WebView2.Core.dll） -->
  <file name="Microsoft.Web.WebView2.Core.dll">
    <activatableClass name="Microsoft.Web.WebView2.Core.CoreWebView2Environment" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
    <activatableClass name="Microsoft.Web.WebView2.Core.CoreWebView2EnvironmentOptions" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
    <activatableClass name="Microsoft.Web.WebView2.Core.CoreWebView2Controller" threadingModel="both" xmlns="urn:schemas-microsoft-com:winrt.v1" />
  </file>
</assembly>

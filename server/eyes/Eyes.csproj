<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>JoinCode.Eyes</RootNamespace>
    <AssemblyName>JoinCode.Eyes</AssemblyName>
    <Description>JoinCode Eyes 子系统 — 代码索引服务、LSP 语言服务</Description>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <PackageId>JoinCode.Eyes</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)lib/abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)server/code_index/CodeIndex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)gen/enum_metadata.generator/EnumMetadata.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(RepoRoot)gen/fsm.generator/Fsm.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>


  </Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>test</ProjectType>
    <OutputType>Exe</OutputType>
    <RootNamespace>PersistenceBenchmarks</RootNamespace>
    <AssemblyName>Persistence.Benchmarks</AssemblyName>
    <ExcludeTestSdk>true</ExcludeTestSdk>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <IsAotCompatible>false</IsAotCompatible>
    <PublishAot>false</PublishAot>
    <TrimMode></TrimMode>
    <NoWarn>$(NoWarn);VSTHRD200;JCC9001;JCC9104</NoWarn>
    <ExcludeStructura>true</ExcludeStructura>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="$(BenchmarkDotNetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)lib/infrastructure/Infrastructure.csproj" />
  </ItemGroup>

</Project>

    <ProjectReference Include="$(RepoRoot)app/cli/JoinCode.csproj" />
    <ProjectReference Include="$(RepoRoot)lib/infrastructure/Infrastructure.csproj" />

    <ProjectReference Include="$(RepoRoot)lib/abstractions/Abstractions.csproj" />
    <ProjectReference Include="$(RepoRoot)kit/mcp/Mcp.csproj" />
    <ProjectReference Include="$(RepoRoot)server/dream/Dream.csproj" />
    <ProjectReference Include="$(RepoRoot)server/eyes/Eyes.csproj" />
    <ProjectReference Include="$(RepoRoot)server/code_index/CodeIndex.csproj" />
    <ProjectReference Include="$(RepoRoot)test/unit/testing.common/Testing.Common.csproj" />

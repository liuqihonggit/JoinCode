<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Infra.Services.Tests</RootNamespace>
    <AssemblyName>JoinCode.Infra.Services.Tests</AssemblyName>
    <Description>JoinCode Infrastructure Services 单元测试</Description>
    <NoWarn>$(NoWarn);JCC3007;JCC3010;JCC3011;JCC3012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)infrastructure\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="$(RepoRoot)composition\Composition\src\Composition.csproj" />
    <ProjectReference Include="$(RepoRoot)tests\Unit\Testing.Common\Testing.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(MicrosoftExtensionsTimeProviderTestingVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Pipeline\**\*.cs" />
    <Compile Include="..\Telemetry\**\*.cs" />
    <Compile Include="..\LLM\**\*.cs" />
    <Compile Include="..\Housekeeping\**\*.cs" />
    <Compile Include="..\Network\**\*.cs" />
    <Compile Include="..\GlobalUsings.cs" Link="GlobalUsings.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>

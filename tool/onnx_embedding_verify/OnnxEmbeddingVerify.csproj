<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectType>tool</ProjectType>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <PublishAot>false</PublishAot>
    <AssemblyName>onnx-embedding-verify</AssemblyName>
    <RootNamespace>OnnxEmbeddingVerify</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ExcludeJccAnalyzers>true</ExcludeJccAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.22.1" />
  </ItemGroup>

</Project>
